#!/usr/bin/env bash
#
# ufw-docker — make plain `ufw allow/deny` actually govern Docker-published ports.
#
#   ufw-docker install         wire ufw into Docker's DOCKER-USER chain
#                              (also enables a boot-time repair service;
#                               --no-selfheal to skip it)
#   ufw-docker remove          preview the undo; --force to actually do it
#   ufw-docker remove --force --include-backups
#                              ...and delete old backups/rescue snapshots too
#   ufw-docker install --dry-run
#                              show exactly what install would write, and change
#                              nothing at all
#   ufw-docker install --unsupported --force
#                              install on an environment we have NOT proven.
#                              Both flags are required, and the fact is recorded
#                              in the stanza and reported by every `status`.
#   ufw-docker status          report what is wired and whether it is healthy
#   ufw-docker status --rules  ...and list the ufw rules containers are judged by
#   ufw-docker status --json   the same report, machine-readable, for monitoring
#   ufw-docker status --counters
#                              ...and DOCKER-USER packet/byte counts
#   ufw-docker remove --force --purge
#                              ...and delete this binary too
#   ufw-docker containers      container addresses, for per-container rules
#   ufw-docker platforms       the platforms this tool is proven on, and whether
#                              this host is one of them
#   ufw-docker rescue          get SSH back and rebuild ufw after a bad state
#   ufw-docker rescue --open   emergency: firewall OFF, you are definitely back in
#   ufw-docker --version       print the version
#
#   ufw-docker <subcommand> --help
#                              flags and caveats for that subcommand

#
# Docker publishes ports by DNAT in PREROUTING and then FORWARDs them, while ufw
# filters INPUT. Forwarded traffic never traverses INPUT, so `ufw deny 443` has
# no effect on a published port -- the firewall reports a rule that does nothing.
#
# This bridges the two so the commands operators already know apply to containers.

set -uo pipefail

VERSION="1.0.0"

MARK_BEGIN="# BEGIN DOCKER-UFW"
MARK_END="# END DOCKER-UFW"

# ── where ufw keeps its files ──────────────────────────────────────────────
# Debian defaults, overridden by whatever this ufw was actually packaged with.
# A wrong hardcoded path fails SILENTLY -- we write a stanza nothing ever reads
# and report success -- which is the single worst failure this tool has.
UFW_DIR=/etc/ufw
AFTER4="$UFW_DIR/after.rules"
AFTER6="$UFW_DIR/after6.rules"
USER4="$UFW_DIR/user.rules"
BEFORE_INIT="$UFW_DIR/before.init"
# ufw's own switches live OUTSIDE $UFW_DIR -- ufw reads config_dir/default/ufw,
# i.e. /etc/default/ufw, not /etc/ufw/default. IPV6= in here decides whether ufw
# loads after6.rules AT ALL, which is why we have to read it: see
# ufw_ipv6_enabled().
UFW_DEFAULTS=/etc/default/ufw

# ufw is a Python program, and its shebang names the interpreter that is
# guaranteed to be able to import its modules. Using a bare `python3` instead
# would be guessing: a host can have several, and only the one ufw itself runs
# under is certain to see `ufw.common`.
ufw_python() {
    local ufwbin sb
    ufwbin="$(command -v ufw 2>/dev/null)" || return 1
    [ -n "$ufwbin" ] || return 1
    sb="$(head -1 "$ufwbin" 2>/dev/null)"
    case "$sb" in
        '#!'*python*) printf '%s' "${sb#\#!}" | awk '{print $1}' ;;
        *) return 1 ;;
    esac
}

# ufw exposes no CLI flag for its own paths, but its Python module carries the
# packager-patched constants. Derive -> fall back to the Debian defaults ->
# VERIFY the files exist. The verification is the point: deriving a wrong path
# and trusting it is no better than hardcoding a wrong one.
#
# NOTE config_dir is `/etc`, NOT `/etc/ufw` -- ufw appends the "ufw" component
# itself. Getting that wrong yields /etc/after.rules, which does not exist, so
# the existence check below catches it rather than letting it through.
UFW_PATHS_DERIVED=0
derive_ufw_paths() {
    local py cfg
    if py="$(ufw_python)" && [ -n "$py" ]; then
        cfg="$("$py" -c 'import ufw.common as c; print(c.config_dir)' 2>/dev/null)"
        if [ -n "$cfg" ] && [ -d "$cfg/ufw" ]; then
            UFW_DIR="$cfg/ufw"
            UFW_PATHS_DERIVED=1
        fi
    fi
    AFTER4="$UFW_DIR/after.rules"
    AFTER6="$UFW_DIR/after6.rules"
    USER4="$UFW_DIR/user.rules"
    BEFORE_INIT="$UFW_DIR/before.init"
    # Sibling of $UFW_DIR, not a child: config_dir is /etc, so ufw's defaults
    # file is /etc/default/ufw while its rules are in /etc/ufw.
    UFW_DEFAULTS="${UFW_DIR%/ufw}/default/ufw"
}

# Which of ufw's files we require, and whether they are all there. Used by the
# preflight; separate from derive_ufw_paths so the paths can be reported even
# when they do not resolve.
ufw_paths_ok() {
    [ -d "$UFW_DIR" ] && [ -f "$AFTER4" ] && [ -f "$USER4" ]
}


# ── is this environment one we have actually proven? ───────────────────────
# Nothing enforced our "untested" caveats, so a host outside them got the worst
# possible outcome: `install` succeeds, `status` reports everything wired, and
# nothing is filtered. A caveat in a document does not protect anybody.
#
# Every check below answers "have we PROVEN this works here?", not "does this
# look dangerous?". That distinction matters -- see A7 in TODO.md, where
# --network host containers are correctly NOT a preflight failure because they
# are understood, merely not governed by us.
PF_FAILED=""      # space-separated keys
PF_DETAIL=""      # one "key|explanation|what to do" per line

pf_fail() {   # $1=key  $2=explanation  $3=remedy
    PF_FAILED="${PF_FAILED}${PF_FAILED:+ }$1"
    PF_DETAIL="${PF_DETAIL}$1|$2|$3"$'\n'
}

# Rules, not chains. Both backends always have the built-in chains, so counting
# chains reports "mixed" on every host. Only `-A` lines mean somebody is
# actually filtering there.
backend_rules() {   # $1 = iptables-legacy | iptables-nft
    command -v "$1" >/dev/null 2>&1 || { printf '0'; return; }
    # `grep -c` PRINTS 0 and EXITS 1 when there is no match, so a `|| printf 0`
    # fallback emits "0\n0" and every arithmetic test downstream breaks. Capture
    # first, then default. (The survey script had this exact bug with
    # `systemctl is-enabled`.)
    local n
    n="$("$1" -S 2>/dev/null | grep -c '^-A')" || true
    printf '%s' "${n:-0}"
}

# Is DOCKER-USER actually REACHED by anything?
#
# Everything else in this tool checks what is INSIDE DOCKER-USER -- the jumps
# we add, the subnets they cover, whether ufw rebuilt them. None of that means
# a packet ever arrives. Docker puts `-A FORWARD -j DOCKER-USER` at the top of
# FORWARD, and if that jump is absent the chain is an orphan: our stanza is
# byte-perfect, `status` counts three jumps into ufw-user-input, and nothing
# is filtered at all.
#
# That is the exact failure this whole design exists to prevent, and until now
# it was the one case nothing looked for. It is not hypothetical -- `"iptables":
# false` in daemon.json tells Docker not to manage iptables, and then the jump
# is never created.
forward_reaches_docker_user() {   # $1 = iptables|ip6tables
    "$1" -S FORWARD 2>/dev/null | grep -q -- '-j DOCKER-USER'
}

# Docker's own firewall backend, as reported by `docker info`. Empty on any
# daemon older than API 1.49, which simply predates the field -- and predates
# the nftables backend too, so empty is the right answer there.
docker_firewall_backend() {
    docker info --format '{{if .FirewallBackend}}{{.FirewallBackend.Driver}}{{end}}' 2>/dev/null
}

# Empty when the backend is one this tool can work with; otherwise the name of
# the one it cannot. Split out from preflight so the classification can be
# tested against synthetic values -- there is no way to stand up an nftables
# backend in CI, and an untested branch on a refusal path is how a tool starts
# refusing hosts that were fine.
unsupported_firewall_backend() {
    local fwb; fwb="$(docker_firewall_backend)"
    case "$fwb" in
        ""|iptables|iptables-legacy|iptables-nft) ;;
        *) printf '%s\n' "$fwb" ;;
    esac
}

preflight() {
    PF_FAILED=""; PF_DETAIL=""

    # 1. (There is deliberately no standalone "backend must be nf_tables"
    #    check. The backend is a COLUMN in the platform matrix below, so a
    #    hardcoded check here would be a second source of truth for the same
    #    question -- and the two would disagree the moment a legacy row was
    #    proven, which is exactly what happened. The matrix owns it.)

    # 2. Mixed backends. The kernel evaluates BOTH, and a DROP in either wins --
    #    so our stanza can be perfectly correct in one while the other silently
    #    drops the traffic. This is the single hardest failure here to diagnose
    #    from the outside, because `status` looks entirely healthy.
    local nleg nnft
    nleg="$(backend_rules iptables-legacy)"
    nnft="$(backend_rules iptables-nft)"
    if [ "${nleg:-0}" -gt 0 ] && [ "${nnft:-0}" -gt 0 ]; then
        pf_fail mixed-backends \
            "rules exist in BOTH iptables backends (legacy=$nleg, nft=$nnft); both are evaluated and a DROP in either wins" \
            "reboot after switching backends, or flush the one you are not using"
    fi

    # 3. Swarm. Not run anywhere at Archous, so genuinely untested rather than
    #    known-broken -- but Swarm publishes ports through its own ingress mesh,
    #    which is a different path from the one this tool governs.
    local sw
    sw="$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null)"
    [ -z "$sw" ] || [ "$sw" = inactive ] || pf_fail swarm \
        "Docker Swarm is '$sw'; ingress-mesh publishing is a path this tool does not govern" \
        "not supported — see docs/caveats.md"

    # 4. Rootless Docker. Publishes via a userspace proxy rather than the
    #    kernel DNAT path DOCKER-USER sits on, so our stanza would be wired
    #    into a chain the traffic never reaches.
    local secopt rootdir
    secopt="$(docker info --format '{{range .SecurityOptions}}{{.}} {{end}}' 2>/dev/null)"
    rootdir="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null)"
    case "$secopt$rootdir" in
        *rootless*) pf_fail rootless \
            "Docker is running rootless; published ports do not traverse DOCKER-USER" \
            "not supported — run a rootful daemon, or see docs/caveats.md" ;;
    esac

    # 5. Docker's own firewall backend. READ THE SOURCE BEFORE CHANGING THIS.
    #
    #    Docker is growing a native nftables backend (`"firewall-backend":
    #    "nftables"` in daemon.json, reported by `docker info` as
    #    FirewallBackend.Driver since API 1.49). In that mode there is NO
    #    DOCKER-USER chain at all. moby's own setupUserChains() opens with:
    #
    #        // There's no equivalent to DOCKER-USER in the nftables implementation.
    #        if nftables.Enabled() { return }
    #
    #    so the chain is never created, FORWARD never jumps to it, and every
    #    rule this tool writes would sit in a chain that does not exist. The
    #    whole design rests on DOCKER-USER; this is the one setting that
    #    removes it.
    #
    #    Check 6 below would catch the symptom -- no FORWARD jump -- but it
    #    would report it as "something flushed FORWARD", which sends an
    #    operator looking for a third-party firewall that is not there. Name
    #    the cause.
    local fwb; fwb="$(unsupported_firewall_backend)"
    [ -z "$fwb" ] || pf_fail firewall-backend \
        "Docker's firewall backend is '$fwb', not iptables; there is no DOCKER-USER chain in that mode" \
        "this tool cannot work here — set '\"firewall-backend\": \"iptables\"' in daemon.json, or see docs/caveats.md"

    # 6. Is the chain we are about to fill actually reachable? Gated on Docker
    #    being up, because a stopped daemon has no FORWARD jump and that is not
    #    a misconfiguration -- there is simply nothing to govern yet.
    if docker info >/dev/null 2>&1 && ! forward_reaches_docker_user iptables; then
        pf_fail docker-user-unreachable \
            "FORWARD has no jump to DOCKER-USER, so the stanza would sit in a chain no packet reaches" \
            "Docker creates that jump; '\"iptables\": false' in daemon.json disables it, as does a third-party firewall flushing FORWARD"
    fi

    # 7. Is this platform one anything has actually proven? Deliberately last,
    #    because the five checks above name a MECHANISM that is known to break,
    #    while this one only says "nobody has tried this combination". Both
    #    refuse, but the failures above are the ones worth reading first.
    local mstat; mstat="$(matrix_status)"
    [ "$mstat" = supported ] || pf_fail platform \
        "no proven platform matches this host ($(host_matrix_key)); nearest verdict: $mstat" \
        "run 'ufw-docker platforms' to see the matrix, and tools/ufw-docker-survey to add a row"

    # 7. ufw's own files. If these are not where we think, we write a stanza
    #    nothing reads and report success -- failing silently, which is worse
    #    than failing loudly.
    local how="Debian default — derivation from ufw.common failed"
    [ "$UFW_PATHS_DERIVED" -eq 1 ] && how="derived from ufw.common"
    ufw_paths_ok || pf_fail ufw-paths \
        "ufw's rules files are not where expected (looked in $UFW_DIR; $how)" \
        "unusual ufw packaging; please report with 'ufw-docker status --json'"

    [ -z "$PF_FAILED" ]
}

# Render the failures. Used by install (before refusing) and by status.
pf_report() {
    local key why fix
    while IFS='|' read -r key why fix; do
        [ -n "$key" ] || continue
        bad "  $key: $why"
        say "      $fix"
    done <<EOPF
$PF_DETAIL
EOPF
    return 0
}

# ── the supported-platform matrix ──────────────────────────────────────────
# Lives HERE, in the single shipped file, because the preflight must be able to
# read it on a host that has only ever downloaded `ufw-docker` -- an external
# data file would be the one thing missing exactly when it is needed.
#
# Field order mirrors tools/ufw-docker-survey so a pasted survey line can be
# matched against a row by eye.
#
# THE RULE: a row may say `supported` only where something actually proved it.
# Not "it ought to work", not "it is the same family as one that works". The
# verified-by column has to name the evidence, and a host matching no
# `supported` row is `unverified` -- which the preflight refuses, with the
# documented --unsupported --force override.
#
# A row is a PLATFORM, not a machine. It used to be a machine -- there were
# rows called dev-00 and site-00, two names for one (debian, 12, nf_tables)
# key, one of which justified itself with "same class as dev-00". That is the
# family-resemblance argument the rule three lines up forbids, written into
# the table the rule governs. Hosts we have actually seen are an inventory and
# belong in docs/supported.md, where they are not mistaken for evidence.
#
# Customer names still do not belong in a public repo; the site-NN mapping in
# that inventory is kept outside it.
#
# Matching uses distro + major version + iptables backend. ufw and docker
# versions are recorded but NOT matched on: they move constantly, and gating on
# them would turn every routine upgrade into a refusal.
supported_matrix() {
    # label   | distro | ver | ufw    | backend   | docker | verified-by                   | status
    cat <<'MATRIX'
deb10-nft    | debian | 10 | 0.36   | nf_tables | 26.1.4  | CI leg distro (debian:10, nft)          | supported
deb10-legacy | debian | 10 | 0.36   | legacy    | 26.1.4  | CI leg distro (debian:10, legacy)       | supported
deb11-nft    | debian | 11 | 0.36   | nf_tables | 20.10.5 | CI leg distro (debian:11, nft)          | supported
deb11-legacy | debian | 11 | 0.36   | legacy    | 20.10.5 | CI leg distro (debian:11, legacy)       | supported
deb12-nft    | debian | 12 | 0.36.2 | nf_tables | 20.10.24| CI leg, plus full suite on a 29.7.1 host | supported
deb12-legacy | debian | 12 | 0.36.2 | legacy    | 20.10.24| CI leg distro (debian:12, legacy)       | supported
ubu22-nft    | ubuntu | 22 | 0.36.1 | nf_tables | 29.1.3  | CI leg distro (ubuntu:22.04, nft)       | supported
ubu22-legacy | ubuntu | 22 | 0.36.1 | legacy    | 29.1.3  | CI leg distro (ubuntu:22.04, legacy)    | supported
ubu24-nft    | ubuntu | 24 | 0.36.2 | nf_tables | 29.1.3  | CI legs bats nft x2, and distro nft     | supported
ubu24-legacy | ubuntu | 24 | 0.36.2 | legacy    | 29.1.3  | CI legs bats legacy, and distro legacy  | supported
MATRIX
}

# distro|majorversion|backend for THIS host.
host_matrix_key() {
    local id ver backend
    # shellcheck disable=SC1091
    [ -r /etc/os-release ] && . /etc/os-release 2>/dev/null
    id="${ID:-unknown}"
    ver="${VERSION_ID:-0}"; ver="${ver%%.*}"
    backend="$(iptables --version 2>/dev/null | grep -oE '\(nf_tables\)|\(legacy\)' | tr -d '()')"
    printf '%s|%s|%s' "$id" "$ver" "${backend:-unknown}"
}

trim() { printf '%s' "$1" | sed 's/^ *//; s/ *$//'; }

# supported | unverified | unknown  -- the best status among matching rows.
matrix_status() {
    local want best=unknown l d v uf b dk by st
    want="$(host_matrix_key)"
    while IFS='|' read -r l d v uf b dk by st; do
        [ -n "$l" ] || continue
        [ "$(trim "$d")|$(trim "$v")|$(trim "$b")" = "$want" ] || continue
        case "$(trim "$st")" in
            supported) best=supported; break ;;
            *) [ "$best" = unknown ] && best=unverified ;;
        esac
    done <<EOM
$(supported_matrix)
EOM
    printf '%s' "$best"
}

cmd_platforms() {
    head_ "supported platforms (matched on distro + major version + iptables backend)"
    # Widths follow the longest value a row can hold, not the heading. They
    # were set when labels were five characters; ten-character platform labels
    # pushed every later column out of line, which turns a table into noise.
    local fmt='  %-12s %-6s %-3s %-6s %-9s %-8s %-40s %s\n'
    # shellcheck disable=SC2059
    printf "$fmt" LABEL DISTRO VER UFW BACKEND DOCKER VERIFIED-BY STATUS
    local l d v uf b dk by st
    while IFS='|' read -r l d v uf b dk by st; do
        [ -n "$l" ] || continue
        # shellcheck disable=SC2059
        printf "$fmt" \
            "$(trim "$l")" "$(trim "$d")" "$(trim "$v")" "$(trim "$uf")" \
            "$(trim "$b")" "$(trim "$dk")" "$(trim "$by")" "$(trim "$st")"
    done <<EOM
$(supported_matrix)
EOM
    say ""
    say "this host: $(host_matrix_key)  ->  $(matrix_status)"
    say ""
    say "A row may say 'supported' only where the verified-by column names real"
    say "evidence. Add a row by surveying the host (tools/ufw-docker-survey) and"
    say "getting a green CI leg for it — not by assuming a family resemblance."
}

# Rules in a ufw user.rules file that PERMIT a given port.
#
# Not just `--dport <port>`. That was the whole bug: `ufw allow in on wg0`
# writes `-A ufw-user-input -i wg0 -j ACCEPT`, with no --dport at all, so a
# host whose only SSH path was an interface or a source read as "no SSH rule"
# -- and rescue then opened the port to the world. Measured, not theorised.
#
# So: an explicit rule for the port, OR any ACCEPT that names no port at all,
# since a rule without a port permits every port including this one.
# B7: four sources, in order of how much they actually know. Shared, because
# `status` has to ask the same question `rescue` does and two answers would be
# worse than none.
#
# `sshd -T` is authoritative ONLY where sshd owns its own listener. Socket
# activation has been the default since Ubuntu 22.10, and there `sshd -T`
# happily reports 22 while ssh.socket listens somewhere else -- a confident
# wrong answer, and the consequence is opening the wrong port while leaving
# the real one shut.
SSH_SRC=""
detect_ssh_ports() {
    local ports
    ports="$(systemctl show ssh.socket sshd.socket -p ListenStream 2>/dev/null \
        | sed 's/^ListenStream=//' | grep -oE '[0-9]+$' | sort -u)"
    SSH_SRC="systemd socket activation"
    if [ -z "$ports" ]; then
        ports="$(sshd -T 2>/dev/null | awk '/^port /{print $2}')"
        SSH_SRC="sshd -T"
    fi
    if [ -z "$ports" ]; then
        # `split()` RETURNS the element count; do not reach for `length(a)`.
        # Debian 10's mawk rejects length() on an array outright -- `awk: line
        # 1: illegal reference to array a` -- so this whole branch produced
        # nothing there, silently, and SSH port detection fell through to the
        # port-22 guess. Found by the Debian 10 CI leg, which is the entire
        # reason that leg exists.
        ports="$(ss -tlnp 2>/dev/null \
            | awk '/sshd/{n=split($4,a,":"); print a[n]}' | sort -u)"
        SSH_SRC="listening sockets"
    fi
    if [ -z "$ports" ]; then
        # Say it is a GUESS. Presenting a fallback as a finding is how an
        # operator ends up trusting a number nothing measured.
        ports=22
        SSH_SRC="GUESS"
    fi
    printf '%s' "$ports"
}

# A blanket SSH ACCEPT sitting directly in INPUT that ufw did not put there.
#
# Older versions of `rescue` inserted exactly this, and if ufw then came back
# WITHOUT its own SSH rule the blanket was left in place -- permanently, and
# silently, on a host whose SSH was meant to be restricted. That behaviour is
# gone, but the rules it already left behind are still out there, so `status`
# names them.
stray_ssh_accept() {
    local port
    for port in $(detect_ssh_ports); do
        iptables -S INPUT 2>/dev/null \
            | grep -E -- "^-A INPUT .*--dport ${port}( |$).*-j ACCEPT" \
            | grep -v -- '-s '
    done
}

ssh_rules_in() {   # $1 = rules file, $2 = port
    local f="$1" port="$2"
    [ -r "$f" ] || return 0
    grep -E -- "^-A ufw6?-user-input .*--dport ${port}( |$)" "$f" 2>/dev/null
    # multiport: `ufw allow 22,2222/tcp` and any ufw APPLICATION PROFILE
    # covering more than one port write `--dports a,b,c` instead. The port has
    # to match a whole list ELEMENT -- a substring match would read
    # `--dports 2222` as permitting 22, which is the opposite of safe.
    grep -E -- "^-A ufw6?-user-input .*--dports ([0-9]+,)*${port}(,[0-9]+)*( |$)" "$f" 2>/dev/null
    # Portless permission: an interface- or source-scoped allow. Must exclude
    # BOTH spellings above, or every multiport rule is counted twice.
    grep -E -- '^-A ufw6?-user-input ' "$f" 2>/dev/null \
        | grep -v -- '--dport' | grep -E -- '-j (ACCEPT|ufw-user-limit-accept)'
}

# Is every current preflight failure one the operator already accepted?
# $1 = current failed keys, $2 = keys recorded in the stanza at install time.
pf_all_accepted() {
    local k
    [ -n "$2" ] || return 1
    for k in $1; do
        case " $2 " in *" $k "*) ;; *) return 1 ;; esac
    done
    return 0
}

# Was this host wired while failing the preflight? The stanza carries the
# answer, so it survives the binary being replaced -- and so `status` can keep
# saying so on a host nobody remembers forcing.
# Set by install only when --unsupported --force was accepted; baked into
# the stanza so the fact outlives the shell that did it.
UNSUP_MARK=""
MARK_UNSUP="# INSTALLED IN UNSUPPORTED MODE:"
installed_unsupported() {
    grep -oE "$MARK_UNSUP.*" "$AFTER4" 2>/dev/null | head -1 | sed "s/$MARK_UNSUP *//"
}
RED=$'\033[31m'; GRN=$'\033[32m'; YLW=$'\033[33m'; OFF=$'\033[0m'
ok()   { printf '  %s%s%s\n' "$GRN" "$*" "$OFF"; }
warn() { printf '  %s%s%s\n' "$YLW" "$*" "$OFF"; }
bad()  { printf '  %s%s%s\n' "$RED" "$*" "$OFF"; }
say()  { printf '  %s\n' "$*"; }
head_(){ printf '\n%s\n' "$*"; }
die()  { bad "$*"; exit 1; }

# Every state-changing action goes to syslog. Without this, "who wired this host
# and when" has no answer -- the self-heal unit logs because systemd captures its
# output, but the tool run by hand left nothing behind at all. Deliberately
# best-effort: a missing `logger` must never stop a rescue.
audit() {
    command -v logger >/dev/null 2>&1 \
        && logger -t ufw-docker -p daemon.notice -- "$*" 2>/dev/null
    return 0
}

require_root() { [ "$(id -u)" -eq 0 ] || die "must run as root (try: sudo $0 $*)"; }

# Every subcommand -- including the read-only ones -- must talk to Docker.
#
# The socket is root:docker 0660, so a plain user outside that group cannot use
# it. Checked up front and named plainly, because the alternative is worse than
# a failure: the docker calls return empty and `status` concludes "is the ucrm
# container running?", blaming the container for a permissions problem.
require_docker() {
    command -v docker >/dev/null 2>&1 || die "docker is not installed, or not on PATH"
    docker info >/dev/null 2>&1 && return 0

    [ "$(id -u)" -eq 0 ] && die "cannot talk to the Docker daemon even as root — is it running?"

    bad "cannot talk to the Docker daemon as $(id -un)"
    say ""
    say "  The socket is normally root:docker 0660, so this needs either:"
    say "    sudo $0 ${1:-status}"
    say "  or membership of the docker group:"
    say "    sudo usermod -aG docker $(id -un)   # then log out and back in"
    exit 1
}

# Readable config, checked separately so the message names the real obstacle.
require_readable() {
    [ -r $AFTER4 ] && [ -r $USER4 ] && return 0
    bad "cannot read $UFW_DIR as $(id -un) — re-run with sudo"
    exit 1
}

# Keep a few backups, not every one ever made. Twelve accumulated on the dev box
# before anyone noticed; a backup nobody prunes is just litter in /etc.
KEEP_BACKUPS=3
prune_backups() {   # $1 = glob prefix
    local n; n=$(ls -1t "$1"* 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | wc -l)
    [ "$n" -gt 0 ] || return 0
    ls -1t "$1"* 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | while read -r f; do rm -rf "$f"; done
    say "pruned $n old backup(s), keeping the newest $KEEP_BACKUPS"
}

# ── self-heal unit (opt-in) ────────────────────────────────────────────────
# Boot ordering between ufw and docker is the one thing this design cannot fully
# control, and its failure mode is the worst one: ufw comes up without an SSH
# rule and nobody can log in to fix it.
#
# ON BY DEFAULT, and `--no-selfheal` opts out.
#
# This was briefly opt-in, on the reasoning that it is "a destructive repair run
# unattended". That was wrong: it fires ONLY when ufw came up with no SSH rule at
# all -- a host that is already unreachable. There is no healthy state it can
# damage, and the alternative is somebody driving to a console. A default should
# be the safe one, and here safe means "you can still log in".
#
# `--no-selfheal` exists for hosts whose boot-time state is owned by config
# management or an immutable image, where an unexpected unit is the bigger
# surprise.
SELFHEAL_UNIT=/etc/systemd/system/ufw-docker-selfheal.service

install_selfheal() {
    cat > "$SELFHEAL_UNIT" <<'UNIT'
[Unit]
Description=Repair ufw if it came up half-built (ufw + Docker integration)
After=ufw.service docker.service
Wants=ufw.service

[Service]
# The check is deliberately narrow -- "is there an SSH rule in ufw-user-input" --
# because that is the single symptom that locks people out. A broader health
# check would risk running a destructive rebuild over a merely unusual state.
Type=oneshot
ExecStart=/usr/local/sbin/ufw-docker selfheal
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT
    systemctl daemon-reload 2>/dev/null
    systemctl enable ufw-docker-selfheal.service >/dev/null 2>&1 \
        && ok "self-heal service installed and enabled" \
        || warn "self-heal service written but could not be enabled"

    # Not fatal -- the firewall this run just wrote is correct either way. But
    # the unit is dead until the binary is there, so say what fixes it rather
    # than only that it is wrong. `status` now re-reports this every run; it
    # used to be mentioned here once and never again.
    [ -x /usr/local/sbin/ufw-docker ] \
        || warn "the unit calls /usr/local/sbin/ufw-docker, which is not there yet — it
    will FAIL at every boot until it is:
        sudo install -m 0755 $0 /usr/local/sbin/ufw-docker"
}

# Which binary does the installed unit actually call? Read it out of the unit
# rather than assuming /usr/local/sbin/ufw-docker, so an operator who edited
# the path still gets a true answer.
#
# systemd allows ExecStart=-/path, @/path and a few other prefix characters;
# strip them, then take the first word.
selfheal_execstart() {
    [ -f "$SELFHEAL_UNIT" ] || return 1
    sed -n 's/^ExecStart=//p' "$SELFHEAL_UNIT" 2>/dev/null \
        | head -1 | sed 's/^[-@:+!]*//' | awk '{print $1}'
}

remove_selfheal() {
    [ -f "$SELFHEAL_UNIT" ] || return 0
    systemctl disable --now ufw-docker-selfheal.service >/dev/null 2>&1
    rm -f "$SELFHEAL_UNIT"
    systemctl daemon-reload 2>/dev/null
    ok "self-heal service removed"
}

# Docker subnets, per address family. Derived at install time rather than
# hardcoding 172.16/12: a user-defined network can sit on 10.x or 192.168.x, and
# anything missed here would be silently dropped.
subnets() {   # $1 = 4|6
    # BRIDGE NETWORKS ONLY, and the filter is load-bearing.
    #
    # This used to take every network's subnet regardless of driver, which is
    # wrong in the dangerous direction. A `macvlan` or `ipvlan` network sits on
    # a REAL LAN -- 192.168.1.0/24, say -- and its traffic does not traverse
    # DOCKER-USER at all. Sweeping that subnet in would have put four rules at
    # the very top of FORWARD governing every packet routed towards that LAN,
    # container or not:
    #
    #     -A DOCKER-USER -s 192.168.1.0/24 -j RETURN          <- exempts the LAN
    #     -A DOCKER-USER -d 192.168.1.0/24 -j ufw-user-input  <- judges the LAN
    #     -A DOCKER-USER -d 192.168.1.0/24 -j ufw-docker-logging-deny
    #
    # So: an entire real network silently exempted from forward filtering in
    # one direction and default-denied in the other, for containers this tool
    # cannot govern anyway. All of the hazard, none of the benefit.
    #
    # Allowlist rather than denylist, because an unknown third-party driver is
    # exactly the case where guessing is wrong. Anything excluded is REPORTED
    # by `status` and `containers` -- see nonbridge_networks -- because the one
    # thing worse than not governing a network is not governing it quietly.
    docker network ls -q 2>/dev/null | while read -r id; do
        docker network inspect "$id" --format \
            '{{if eq .Driver "bridge"}}{{range .IPAM.Config}}{{.Subnet}} {{end}}{{end}}' 2>/dev/null
    done | tr ' ' '\n' | grep -E '[0-9a-fA-F]' | {
        if [ "$1" = "6" ]; then grep ':'; else grep -v ':'; fi
    } | sort -u
}

# Networks this tool deliberately does NOT govern, with why. Same discipline as
# host-network containers: name them plainly rather than letting someone
# discover the gap by being attacked through it.
nonbridge_networks() {
    docker network ls -q 2>/dev/null | while read -r id; do
        docker network inspect "$id" --format \
            '{{if and (ne .Driver "bridge") (ne .Driver "null") (ne .Driver "host")}}{{.Name}}|{{.Driver}}|{{range .IPAM.Config}}{{.Subnet}} {{end}}{{end}}' 2>/dev/null
    done | grep -E '\|' | sort -u
}

# Rootless Docker daemons on this host (A9). Two signals, because either on its
# own misses a real case: the conventional socket under $XDG_RUNTIME_DIR, and a
# dockerd that simply is not running as root.
#
# WHAT A ROOTLESS PUBLISHED PORT ACTUALLY IS, because it changes the advice:
# it is a USERSPACE listener owned by that user on the host, not a DNAT. So the
# traffic arrives on INPUT, exactly like any host service -- it never reaches
# FORWARD, never reaches DOCKER-USER, and nothing this tool writes applies to
# it. Measured, not reasoned: a rootless container publishing 18099 showed ZERO
# matching rules in iptables-save, and `ufw deny 18099/tcp` blocked it outright.
#
# So these containers are not unprotected. They are protected by ordinary ufw,
# under the ordinary default policy -- which is the opposite of the bridge
# containers this tool governs, and worth saying out loud rather than leaving
# an operator to assume `ufw-docker status` covered everything on the box.
rootless_daemons() {
    local s uid name seen=""
    for s in /run/user/*/docker.sock; do
        [ -S "$s" ] || continue
        uid="${s#/run/user/}"; uid="${uid%/docker.sock}"
        name="$(getent passwd "$uid" 2>/dev/null | cut -d: -f1)"
        name="${name:-uid $uid}"
        seen="$seen $name"
        printf '%s|%s\n' "$name" "$s"
    done
    # The process scan is the fallback, for a host whose XDG_RUNTIME_DIR is not
    # under /run/user. It needs two filters, and the second one is not optional.
    #
    #   1. Skip a user the socket scan already found, or every rootless daemon
    #      is reported twice -- once per signal -- and reads as two daemons.
    #
    #   2. Skip any dockerd in a DIFFERENT PID NAMESPACE. A container's
    #      processes are visible in the host's `ps`, so a nested rootless
    #      dockerd -- this project's own test legs, DinD, CI build agents --
    #      made the HOST report a rootless daemon it does not have. Caught on
    #      the development box, which reported `rspaeth` while the daemon in
    #      question was three layers down inside a test container.
    #
    # Comparing against /proc/1 is what makes that precise: inside a container
    # /proc/1 is that container's init, so a genuinely local rootless daemon is
    # still found there. Where the readlink is not permitted -- `status` run
    # unprivileged against another user's process -- we report nothing rather
    # than guess, and the socket scan above still stands.
    local selfns; selfns="$(readlink /proc/1/ns/pid 2>/dev/null)"
    local pid u pns
    ps -eo user:32,pid,args 2>/dev/null \
        | awk '$1 != "root" && /[d]ockerd/ { print $1 " " $2 }' \
        | while read -r u pid; do
            case " $seen " in *" $u "*) continue ;; esac
            pns="$(readlink "/proc/$pid/ns/pid" 2>/dev/null)" || continue
            [ -n "$pns" ] && [ "$pns" = "$selfns" ] || continue
            printf '%s|(dockerd running as this user; socket not under /run/user)\n' "$u"
        done | sort -u
}

# Build the stanza for one family. The chain names differ (ufw-user-input vs
# ufw6-user-input) and so do the rule files.
# Is ufw's own logging on? Our DROP chain carries its own LOG rule, so without
# this check `ufw logging off` would silence ufw and leave us logging anyway --
# a divergence from what the operator actually asked for.
#
# Honest about its limit: this is read at INSTALL time and baked into the
# stanza, so toggling ufw logging afterwards does not change ours. `status`
# compares the two and says so rather than leaving it to be discovered.
# ufw's DEFAULT INCOMING policy, as `allow` or `deny`.
#
# This matters more than it looks. ufw expresses its default policy as the
# POLICY ON THE BUILT-IN CHAIN, not as a terminal rule inside ufw-user-input --
# and our jump goes straight into ufw-user-input, so the default is never
# consulted on the container path. Unmatched container traffic falls out of
# ufw-user-input and lands on ufw-docker-logging-deny, which drops it.
#
# Consequence, on a host running `ufw default allow incoming`: installing this
# tool takes every published container port from OPEN to CLOSED, with no rule
# anywhere in `ufw status` explaining why. That is an outage, caused by the
# install, and the operator has to be told BEFORE it happens.
ufw_default_incoming() {
    ufw status verbose 2>/dev/null \
        | sed -n 's/^Default: *\([a-z]*\) (incoming).*/\1/p' | head -1
}

ufw_logging_on() {
    ufw status verbose 2>/dev/null | grep -qiE '^Logging: +on' 
}

# Is ufw itself doing IPv6?
#
# This matters more than it looks. With IPV6=no, ufw never loads after6.rules
# and never creates ufw6-user-input -- so a v6 stanza we write is DEAD TEXT.
# `status` would have reported the symptom ("IPv6 is NOT wired") and left the
# operator to guess the cause, which is exactly the silent-failure shape this
# tool exists to avoid.
#
# Unreadable file -> report enabled, because that is ufw's own default. The
# failure we must not produce is a false all-clear about v6 being handled;
# claiming it IS on when we cannot tell keeps the v6 checks live.
ufw_ipv6_enabled() {
    [ -r "$UFW_DEFAULTS" ] || return 0
    ! grep -qiE '^[[:space:]]*IPV6[[:space:]]*=[[:space:]]*"?no"?[[:space:]]*$' "$UFW_DEFAULTS"
}

stanza() {   # $1 = 4|6
    local fam="$1" chain fchain nets
    if [ "$fam" = "6" ]; then
        chain="ufw6-user-input";  fchain="ufw6-user-forward"
    else
        chain="ufw-user-input";   fchain="ufw-user-forward"
    fi
    nets="$(subnets "$fam")"
    [ -n "$nets" ] || return 1

    printf '%s\n' "$MARK_BEGIN"
    printf '%s\n' "# Managed by ufw-docker $VERSION. Do not edit; re-run 'install'."
    [ -n "$UNSUP_MARK" ] && printf '%s %s\n' "$MARK_UNSUP" "$UNSUP_MARK"
    printf '%s\n' "*filter"
    printf '%s\n' "# after.rules is restored BEFORE user.rules, so $chain does not"
    printf '%s\n' "# exist yet. Declaring it creates it; user.rules fills it in afterwards."
    printf ':%s - [0:0]\n' "$chain"
    printf ':%s - [0:0]\n' "$fchain"
    printf ':ufw-docker-logging-deny - [0:0]\n'
    printf ':DOCKER-USER - [0:0]\n'
    printf '%s\n' "# Container-originated traffic is Docker's business."
    printf '%s\n' "$nets" | while read -r s; do [ -n "$s" ] && printf -- '-A DOCKER-USER -s %s -j RETURN\n' "$s"; done
    printf -- '-A DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN\n'
    printf '%s\n' "# Judge only what is heading INTO a container network."
    printf '%s\n' "#"
    printf '%s\n' "# ufw route rules FIRST, then plain ufw rules. \`ufw route allow ...\` is the"
    printf '%s\n' "# verb ufw intends for forwarded traffic, so it is the more specific"
    printf '%s\n' "# statement and wins. Plain \`ufw allow\` still works, which is the whole"
    printf '%s\n' "# point of this tool; it is simply consulted second."
    printf '%s\n' "$nets" | while read -r s; do [ -n "$s" ] && printf -- '-A DOCKER-USER -d %s -j %s\n' "$s" "$fchain"; done
    printf '%s\n' "$nets" | while read -r s; do [ -n "$s" ] && printf -- '-A DOCKER-USER -d %s -j %s\n' "$s" "$chain"; done
    printf '%s\n' "# Nothing matched: drop -- logging first, if ufw is logging."
    printf '%s\n' "# Our own chain rather than ufw's ufw-logging-deny: that one is filled in"
    printf '%s\n' "# by a later pass, so declaring it here would flush it and silence ufw's"
    printf '%s\n' "# own logging. Same 3/min limit; distinct prefix so container blocks are"
    printf '%s\n' "# distinguishable from host blocks."
    if ufw_logging_on; then
        printf -- '-A ufw-docker-logging-deny -m limit --limit 3/min --limit-burst 10 -j LOG --log-prefix "[UFW DOCKER BLOCK] "\n'
    else
        printf '%s\n' "# ufw logging is OFF, so ours is too. Re-run 'install' after 'ufw logging on'."
    fi
    printf -- '-A ufw-docker-logging-deny -j DROP\n'
    printf '%s\n' "$nets" | while read -r s; do [ -n "$s" ] && printf -- '-A DOCKER-USER -d %s -j ufw-docker-logging-deny\n' "$s"; done
    printf 'COMMIT\n'
    printf '%s\n' "$MARK_END"
}

strip_stanza() { sed -i "/^${MARK_BEGIN}\$/,/^${MARK_END}\$/d" "$1" 2>/dev/null; }

# Parse the stanza WITHOUT applying it.
#
# Previously a malformed stanza was discovered by `ufw reload` failing -- by
# which point after.rules was already on disk and ufw was half-built, and the
# only thing between the operator and a lockout was the rollback. `--test` does
# a full parse and applies nothing, so a bad stanza can be refused before a
# single byte is written.
#
# The stanza is a complete, self-contained *filter...COMMIT block, which is
# exactly what iptables-restore wants. The BEGIN/END markers are comments, so
# they pass through harmlessly.
#
# WHAT THIS DOES NOT CATCH, measured on iptables 1.8.9 (nf_tables): a jump to a
# chain that does not exist passes --test with rc=0.
#
#     -A DOCKER-USER -d 172.17.0.0/16 -j NOSUCHCHAIN   ->  rc=0
#     -A DOCKER-USER --bogus                           ->  rc=2
#
# So this is a syntax check, not a link check. The unresolvable-jump case is
# covered by construction instead: the stanza declares every chain it jumps to
# (that is what the four ':chain - [0:0]' lines are for), so it cannot name a
# target it did not create. Worth knowing before trusting --test with a hand-
# edited rules file.
validate_stanza() {   # $1 = 4|6 ; stanza text on stdin
    local cmd=iptables-restore
    [ "$1" = "6" ] && cmd=ip6tables-restore
    # No validator is not a reason to block an install; it is a reason to say so.
    command -v "$cmd" >/dev/null 2>&1 || { cat >/dev/null; return 0; }
    # -w: WAIT for the xtables lock rather than failing on it. Without it this
    # check loses a race it has no business losing -- `docker network create`
    # and `ufw reload` both take that lock, and a validation step that reports
    # "the stanza does not parse" because something else was mid-write would
    # refuse a perfectly good install. A transient must not look like a defect.
    "$cmd" --test -w 10 2>&1
}

# Subnets the INSTALLED stanza covers, as opposed to the ones Docker has now.
# The two drift apart the moment someone creates a network after install, and
# nothing else notices: traffic to a new subnet matches none of our rules, so it
# is neither allowed by ufw nor dropped by us.
stanza_subnets() {   # $1 = rules file
    sed -n "/^${MARK_BEGIN}\$/,/^${MARK_END}\$/p" "$1" 2>/dev/null \
        | grep -oE -- '-A DOCKER-USER -d [0-9a-fA-F:./]+' \
        | awk '{print $4}' | sort -u
}

# The hook that makes `ufw reload` survivable -- see the long note inside it.
install_hook() {
    local f=$BEFORE_INIT
    local stock=/usr/share/ufw/before.init

    # Refuse to clobber a hook the operator wrote.
    #
    # This used to `cat >` unconditionally. A backup was taken, but anyone with
    # their own before.init logic would have found it silently replaced and
    # their hook simply not running -- no error, which is the worst way to lose
    # a firewall customisation. Demonstrated on the dev host before this guard
    # existed.
    #
    # ufw ships a pristine template at /usr/share/ufw/before.init; replacing an
    # untouched copy of that is safe. Anything else belongs to the operator.
    if [ -f "$f" ] && ! grep -q 'Managed by ufw-docker' "$f" 2>/dev/null; then
        if [ -f "$stock" ] && cmp -s "$f" "$stock"; then
            :
        else
            bad "$BEFORE_INIT has been customised; refusing to overwrite it"
            say ""
            say "  This tool needs DOCKER-USER emptied before ufw tears its chains down,"
            say "  or 'ufw reload' leaves the firewall half-built and drops your SSH rule."
            say "  Add this to your own before.init, under the start and stop cases:"
            say ""
            say "      for ipt in iptables ip6tables; do"
            say "          command -v \"\$ipt\" >/dev/null 2>&1 || continue"
            say "          \"\$ipt\" -S DOCKER-USER >/dev/null 2>&1 || continue"
            say "          \"\$ipt\" -F DOCKER-USER 2>/dev/null || true"
            say "          \"\$ipt\" -A DOCKER-USER -j RETURN 2>/dev/null || true"
            say "      done"
            say ""
            say "  Then re-run install. Your file has not been touched."
            return 1
        fi
    fi

    [ -f "$f" ] && [ ! -f "$f.ufw-docker-backup" ] && cp -a "$f" "$f.ufw-docker-backup"
    cat > "$f" <<'INIT'
#!/bin/sh
# Managed by ufw-docker.
#
# WHY THIS IS REQUIRED, AND IS NOT OPTIONAL:
#
# ufw deletes and recreates its own chains on every apply. iptables refuses to
# delete a chain that another chain still references -- and after our stanza
# runs once, DOCKER-USER references ufw-user-input. So from the SECOND `ufw
# reload` onward those deletes fail and ufw aborts half-way, leaving the
# firewall broken: logging chains missing and, critically, ufw-user-input EMPTY
# -- which silently removes the SSH allow rule.
#
# Measured without this hook: reload #1 fine; reload #2 -> ufw DOWN, 6 of 11
# logging chains, no SSH rule, box reachable only on existing conntrack entries.
#
# before.init runs BEFORE ufw's delete_chains step, so emptying DOCKER-USER here
# releases the references in time. after.rules repopulates it in the same run.
set -e
flush_docker_user() {
    for ipt in iptables ip6tables; do
        command -v "$ipt" >/dev/null 2>&1 || continue
        "$ipt" -S DOCKER-USER >/dev/null 2>&1 || continue
        "$ipt" -F DOCKER-USER 2>/dev/null || true
        "$ipt" -A DOCKER-USER -j RETURN 2>/dev/null || true
    done
}
case "$1" in
    start|stop|flush-all) flush_docker_user ;;
    status) ;;
    *) echo "'$1' not supported" >&2; exit 1 ;;
esac
exit 0
INIT
    chmod 0750 "$f"
}

cmd_install() {
    require_root install
    require_docker install
    require_readable
    command -v ufw >/dev/null || die "ufw is not installed"

    local selfheal=1 dry=0 unsup=0 force=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-selfheal) selfheal=0 ;;
            --dry-run|-n) dry=1 ;;
            --unsupported) unsup=1 ;;
            --force) force=1 ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done

    local banner="ufw-docker install"
    [ "$dry" -eq 1 ] && banner="$banner (DRY RUN — nothing will be changed)"
    head_ "$banner"

    # ── X1: refuse an environment we have not proven ───────────────────────
    # Deliberately a REFUSAL and not a warning. The failure mode this guards
    # is silent: install succeeds, status reports everything wired, and
    # nothing is actually filtered. A warning scrolls past; a refusal does not.
    if ! preflight; then
        head_ "UNSUPPORTED ENVIRONMENT"
        bad "this host fails checks the tool has only ever been proven under:"
        pf_report
        if [ "$dry" -eq 1 ]; then
            say ""
            warn "a real install would REFUSE here (--dry-run continues so you can see the plan)"
        else
            say ""
            say "Installing here can leave Docker ports UNFILTERED while \`status\`"
            say "reports everything as wired. That is why this refuses."
            if [ "$unsup" -eq 0 ]; then
                say ""
                say "To proceed anyway, knowing the above:"
                say "    ufw-docker install --unsupported --force"
                audit "install REFUSED — unsupported environment ($PF_FAILED)"
                exit 1
            fi
            # --unsupported ALONE still refuses. Two flags, because one flag is
            # something you can paste from a forum post without reading it.
            if [ "$force" -eq 0 ]; then
                say ""
                say "--unsupported alone is not enough. Add --force to confirm you"
                say "have read the above and accept that filtering may not work:"
                say "    ufw-docker install --unsupported --force"
                audit "install REFUSED — --unsupported given without --force ($PF_FAILED)"
                exit 1
            fi
            UNSUP_MARK="$PF_FAILED"
            say ""
            warn "PROCEEDING ANYWAY — --unsupported --force was given."
            warn "This host is NOT a proven configuration. Filtering may silently"
            warn "not work. This is recorded in the stanza and reported by every"
            warn "'ufw-docker status' run from now on."
            audit "install PROCEEDING IN UNSUPPORTED MODE ($PF_FAILED)"
        fi
    fi

    if [ "$(ufw_default_incoming)" = allow ]; then
        say ""
        warn "ufw's default incoming policy is ALLOW, and that changes what this install does."
        warn "Container traffic is judged by ufw-user-input alone; the default policy lives"
        warn "on the built-in chain, which this path never reaches. So anything without an"
        warn "explicit 'ufw allow' will be DROPPED for containers even though the host"
        warn "default is allow — published ports that work today will stop."
        warn "Add the rules you need first, or accept that this is now a default-deny host"
        warn "for container traffic."
        audit "install on a default-ALLOW-incoming host; container traffic becomes default-deny"
    fi

    local v4 v6 wrote=0
    v4="$(subnets 4)"; v6="$(subnets 6)"
    say "IPv4 Docker subnets: $(echo "$v4" | tr '\n' ' ')"
    say "IPv6 Docker subnets: $(echo "$v6" | tr '\n' ' ')${v6:+}"
    [ -z "$v6" ] && say "  (none — Docker IPv6 is off; the v6 stanza is skipped)"

    # Write the v6 stanza anyway when ufw has IPV6=no -- it costs nothing and
    # becomes live the moment someone flips the switch -- but say plainly that
    # it is inert until then. Silently writing a file ufw does not read is how
    # an operator ends up believing v6 is filtered when it is not.
    if [ -n "$v6" ] && ! ufw_ipv6_enabled; then
        warn "ufw has IPV6=no in $UFW_DEFAULTS, so it never loads after6.rules.
    The IPv6 stanza below will be written but NOT consulted, and v6 traffic into
    containers stays unfiltered. 'status' will report this red until it is fixed:
        sudo sed -i 's/^IPV6=.*/IPV6=yes/' $UFW_DEFAULTS
        sudo ufw reload && sudo ufw-docker install"
    fi

    # Generate and PARSE both stanzas before touching anything. `remove`
    # previews by default and `install` did not, which was an inconsistent
    # contract on the more dangerous of the two.
    local s4="" s6="" verr
    if s4="$(stanza 4)"; then
        if ! verr="$(printf '%s\n' "$s4" | validate_stanza 4)"; then
            bad "the generated IPv4 stanza does NOT parse — refusing to write it"
            printf '%s\n' "$verr" | sed 's/^/      /'
            die "nothing was changed"
        fi
        ok "IPv4 stanza parses (iptables-restore --test)"
    fi
    if [ -n "$v6" ] && [ -f $AFTER6 ] && s6="$(stanza 6)"; then
        if ! verr="$(printf '%s\n' "$s6" | validate_stanza 6)"; then
            bad "the generated IPv6 stanza does NOT parse — refusing to write it"
            printf '%s\n' "$verr" | sed 's/^/      /'
            die "nothing was changed"
        fi
        ok "IPv6 stanza parses (ip6tables-restore --test)"
    fi

    if [ "$dry" -eq 1 ]; then
        head_ "would append to $AFTER4"
        printf '%s\n' "$s4" | sed 's/^/      /'
        if [ -n "$s6" ]; then
            head_ "would append to $AFTER6"
            printf '%s\n' "$s6" | sed 's/^/      /'
        fi
        head_ "would also"
        if [ -x $BEFORE_INIT ] && grep -q 'ufw-docker' $BEFORE_INIT 2>/dev/null; then
            say "leave $BEFORE_INIT alone (already ours)"
        else
            say "write $BEFORE_INIT  (required: without it the SECOND"
            say "  'ufw reload' after install breaks the firewall)"
        fi
        [ "$selfheal" -eq 1 ] \
            && say "install and enable ufw-docker-selfheal.service" \
            || say "NOT install the self-heal service (--no-selfheal)"
        say "back up the rules file(s), then run 'ufw reload'"
        say "verify, and roll the stanza back out again if ufw came up unhealthy"
        head_ "result"
        ok "dry run only — nothing was changed"
        return 0
    fi

    audit "install starting (version $VERSION, v4='$(echo "$v4" | tr '\n' ' ')')"

    install_hook || die "cannot proceed without the before.init hook — see above"
    ok "before.init hook installed (required for reload safety)"

    cp -a $AFTER4  "$AFTER4.ufw-docker-bak-$(date +%Y%m%d%H%M%S)"
    strip_stanza $AFTER4
    if [ -n "$s4" ]; then
        printf '%s\n' "$s4" >> $AFTER4
        ok "IPv4 stanza written to after.rules"; wrote=1
    fi

    if [ -n "$s6" ]; then
        cp -a $AFTER6 "$AFTER6.ufw-docker-bak-$(date +%Y%m%d%H%M%S)"
        strip_stanza $AFTER6
        printf '%s\n' "$s6" >> $AFTER6
        ok "IPv6 stanza written to after6.rules"; wrote=1
    fi

    [ "$wrote" -eq 1 ] || die "no Docker subnets found — nothing to wire"

    prune_backups $AFTER4.ufw-docker-bak-
    prune_backups $AFTER6.ufw-docker-bak-

    if [ "$selfheal" -eq 1 ]; then
        install_selfheal
    else
        warn "self-heal service NOT installed (--no-selfheal)"
        say "  if ufw ever comes up without its SSH rule, this host will need"
        say "  console access to recover. 'ufw-docker install' restores it."
    fi

    head_ "applying"
    if ! ufw reload 2>&1 | sed 's/^/  /'; then
        : # ufw's exit code is unreliable through the pipe; the health check below decides
    fi

    # Verify, and ROLL BACK if we broke it.
    #
    # This previously ran `ufw reload` and trusted it. A malformed stanza would
    # leave ufw half-built -- no SSH rule, chains missing -- with the tool
    # reporting success, which is the exact failure this project exists to stop
    # happening by accident.
    local bad_state=0
    ufw status 2>/dev/null | grep -q 'Status: active' || bad_state=1
    [ "$(iptables -S 2>/dev/null | grep -cE '^-N ufw.*logging')" -ge 9 ] || bad_state=1
    [ "$(iptables -S ufw-user-input 2>/dev/null | grep -c -- '--dport')" -gt 0 ] \
        || [ "$(grep -c -- '-A ufw-user-input' $USER4 2>/dev/null)" -eq 0 ] \
        || bad_state=1

    if [ "$bad_state" -eq 1 ]; then
        audit "install FAILED verification — rolling the stanza back out"
        bad "the firewall is NOT healthy after applying — rolling back"
        strip_stanza $AFTER4
        strip_stanza $AFTER6
        ufw reload >/dev/null 2>&1
        if ufw status 2>/dev/null | grep -q 'Status: active'; then
            ok "rolled back; ufw is active again with your rules"
        else
            bad "rollback did not restore ufw — run: ufw-docker rescue"
        fi
        return 1
    fi

    audit "install complete and verified (version $VERSION)"
    cmd_status
}

cmd_remove() {
    require_root remove
    audit "remove invoked ($*)"
    require_docker remove
    require_readable

    local force=0 wipe=0 purge=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --force|-f)        force=1 ;;
            --include-backups) wipe=1 ;;
            --purge)           purge=1 ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done

    # Gated behind --force on purpose. These files are the only way back if this
    # removal itself goes wrong, and the rescue snapshots are incident forensics.
    # Losing either to a stray flag on a dry run would be a bad trade.
    [ "$wipe" -eq 1 ] && [ "$force" -eq 0 ] \
        && die "--include-backups is destructive; pass --force as well"
    [ "$purge" -eq 1 ] && [ "$force" -eq 0 ] \
        && die "--purge deletes this binary; pass --force as well"

    head_ "ufw-docker remove"

    # Show the consequence BEFORE asking, not after. The dangerous part of this
    # operation is not the files it deletes -- it is that the operator's DENY
    # rules quietly stop protecting container ports while `ufw status` keeps
    # printing them unchanged.
    say "WOULD REMOVE:"
    say "  - the DOCKER-UFW stanza from after.rules / after6.rules"
    say "  - our before.init hook (the original is restored if there was one)"
    say "  - the self-heal systemd unit, if installed"
    say "  - every DOCKER-USER rule, leaving Docker's own single RETURN"
    say ""
    local nbak nsnap
    nbak=$(ls -1 $UFW_DIR/after*.rules.ufw-docker-bak-* 2>/dev/null | wc -l)
    nsnap=$(ls -1d /var/backups/ufw-rescue-* 2>/dev/null | wc -l)

    if [ "$wipe" -eq 1 ]; then
        [ "${nbak:-0}"  -gt 0 ] && say "  - $nbak existing after.rules backup(s) in $UFW_DIR"
        [ "${nsnap:-0}" -gt 0 ] && say "  - $nsnap rescue snapshot(s) in /var/backups"
    fi
    say ""
    say "WOULD LEAVE:"
    say "  - all of your ufw rules, untouched"
    say "  - a fresh backup of after.rules, taken before anything is changed"
    if [ "$purge" -eq 0 ]; then
        # B5: it always left the binary and never said so, which is the one
        # question a preview exists to answer. Keeping it is deliberate --
        # reinstalling is the likely next step, and `rescue` has to stay
        # reachable exactly when you have just unwound the firewall.
        say "  - $0 itself  ('rescue' stays available; --purge --force to delete it)"
    fi
    if [ "$wipe" -eq 0 ]; then
        [ "${nbak:-0}"  -gt 0 ] && say "  - $nbak older after.rules backup(s)  (--include-backups to delete)"
        [ "${nsnap:-0}" -gt 0 ] && say "  - $nsnap rescue snapshot(s)           (--include-backups to delete)"
    fi
    say ""
    warn "after this, your ufw rules will NO LONGER affect Docker-published ports."
    local denies; denies=$(ufw status 2>/dev/null | grep -ciE '^[0-9].*DENY' || true)
    if [ "${denies:-0}" -gt 0 ]; then
        warn "these $denies DENY rule(s) will stop closing container ports:"
        ufw status 2>/dev/null | grep -iE '^[0-9].*DENY' | sed 's/^/      /'
    fi
    say ""

    # No prompt. Without --force this is a dry run: it reports exactly what it
    # WOULD do and changes nothing. That behaves identically at a console and in
    # a script, needs no tty, and makes the preview above useful on its own --
    # whereas a y/N prompt is both skippable by habit and awkward to automate.
    if [ "$force" -eq 0 ]; then
        say "nothing has been changed."
        say "re-run with --force to go ahead:"
        say "    sudo ufw-docker remove --force"
        return 0
    fi

    # Back up BEFORE modifying, exactly as install does. Without this, a bad
    # strip would leave no way back to the working after.rules.
    local keep; keep="$AFTER4.ufw-docker-bak-$(date +%Y%m%d%H%M%S)"
    cp -a $AFTER4 "$keep"
    say "backed up after.rules -> $(basename "$keep")"

    strip_stanza $AFTER4  && ok "IPv4 stanza removed"
    strip_stanza $AFTER6 && ok "IPv6 stanza removed"
    # Restore the original if we have one; otherwise still strip OUR hook rather
    # than leaving it behind. Relying on a backup existing meant that on a host
    # with no original before.init, our hook survived `remove` uninvited.
    if [ -f $BEFORE_INIT.ufw-docker-backup ]; then
        mv $BEFORE_INIT.ufw-docker-backup $BEFORE_INIT
        chmod 0640 $BEFORE_INIT
        ok "before.init restored to its original"
    elif grep -q 'ufw-docker' $BEFORE_INIT 2>/dev/null; then
        rm -f $BEFORE_INIT
        ok "before.init hook removed (there was no original to restore)"
    fi

    remove_selfheal
    for ipt in iptables ip6tables; do
        "$ipt" -S DOCKER-USER >/dev/null 2>&1 || continue
        "$ipt" -F DOCKER-USER 2>/dev/null; "$ipt" -A DOCKER-USER -j RETURN 2>/dev/null
    done
    ok "DOCKER-USER reset to stock"
    ufw reload 2>&1 | sed 's/^/  /'
    cmd_status || true

    if [ "$wipe" -eq 1 ]; then
        # Everything except the backup this run just took.
        local n=0
        for f in $UFW_DIR/after*.rules.ufw-docker-bak-*; do
            [ -e "$f" ] || continue
            [ "$f" = "$keep" ] && continue
            rm -f "$f" && n=$((n + 1))
        done
        for d in /var/backups/ufw-rescue-*; do
            [ -e "$d" ] || continue
            rm -rf "$d" && n=$((n + 1))
        done
        ok "deleted $n backup(s)/snapshot(s); kept $(basename "$keep")"
    fi

    head_ "done"
    say "your ufw rules still apply to services on the HOST, unchanged."
    warn "they no longer affect Docker-published ports."
    if [ "$purge" -eq 1 ]; then
        # From a TRAP, not here. bash reads a script incrementally as it
        # executes, so deleting the file we are running from mid-run can make
        # the interpreter read garbage off the freed inode. Deferring to exit
        # means every byte has already been read.
        PURGE_SELF="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
        trap 'rm -f "$PURGE_SELF"' EXIT
        warn "deleting $PURGE_SELF on exit — 'rescue' is no longer available here"
    else
        say "$0 is still installed; 'rescue' remains available."
    fi
}

# What the self-heal unit runs at boot.
#
# A subcommand rather than a shell one-liner wedged into ExecStart: the previous
# version was a backslash-continued blob inside a unit file, which could not be
# read, tested or fixed like the rest of this tool.
cmd_selfheal() {
    require_root selfheal
    sleep "${SELFHEAL_DELAY:-20}"

    local repaired=0

    # 1. The symptom that locks people out.
    if ! iptables -S ufw-user-input 2>/dev/null | grep -q -- '--dport'; then
        logger -t ufw-docker-selfheal "ufw has no user rules at boot - running rescue"
        cmd_rescue >/var/log/ufw-docker-selfheal.log 2>&1
        repaired=1
    fi

    # 2. The symptom nobody would otherwise see: the stanza is installed but our
    #    jumps are gone, so container ports are unfiltered while everything
    #    LOOKS fine -- ufw active, rules listed, nothing in any log. That is
    #    exactly what a future Docker flushing DOCKER-USER on startup would
    #    produce. A reload re-applies after.rules; no need for a full rescue.
    if grep -q "$MARK_BEGIN" $AFTER4 2>/dev/null \
       && [ "$(iptables -S DOCKER-USER 2>/dev/null | grep -c 'ufw-user-input')" -eq 0 ]; then
        logger -t ufw-docker-selfheal "stanza installed but DOCKER-USER unwired - reloading ufw"
        ufw reload >>/var/log/ufw-docker-selfheal.log 2>&1
        repaired=1
    fi

    # 3. UNWIRED, for any reason. This used to be gated on `repaired -eq 1`,
    #    on the assumption that the only way to lose the stanza was a rescue
    #    having just stripped it. It is not: `after.rules` is a dpkg CONFFILE,
    #    so an ufw package upgrade can replace it, and config management can
    #    template over it. In both cases ufw is perfectly healthy, nothing
    #    needed repairing, and this unit logged "ufw healthy at boot" about a
    #    host whose Docker ports were wide open.
    #
    #    Noticing an unfiltered host is the entire reason this unit exists, so
    #    the check cannot be a side effect of having repaired something else.
    #
    #    Deliberately NOT auto-reinstalling: if the stanza is what broke ufw,
    #    re-applying it every boot is a loop, and an unfiltered host that says
    #    so beats one that flaps.
    if ! grep -q "$MARK_BEGIN" $AFTER4 2>/dev/null; then
        if [ "$repaired" -eq 1 ]; then
            logger -t ufw-docker-selfheal \
                "RECOVERED but UNWIRED: ufw rules no longer affect Docker ports - run 'ufw-docker install'"
        else
            logger -t ufw-docker-selfheal \
                "UNWIRED: ufw is healthy but the stanza is GONE - Docker ports are unfiltered - run 'ufw-docker install'"
        fi
        return 0
    fi

    # 4. Reachability. The stanza can be present and correct in a chain that
    #    nothing jumps to; see forward_reaches_docker_user.
    if ! forward_reaches_docker_user iptables; then
        logger -t ufw-docker-selfheal \
            "UNREACHABLE: FORWARD does not jump to DOCKER-USER - the stanza is in an orphaned chain and nothing is filtered"
        return 0
    fi

    [ "$repaired" -eq 0 ] && logger -t ufw-docker-selfheal "ufw healthy at boot"
    return 0
}

# Container addresses, so a per-container rule can be written without looking
# them up by hand. Flags dynamic ones: a rule written against an address that
# changes on recreate silently stops matching the container it was written for.
container_rows() {
    docker ps --format '{{.Names}}' 2>/dev/null | while read -r c; do
        [ -n "$c" ] || continue
        ip=$(docker inspect "$c" --format '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' 2>/dev/null | awk '{print $1}')
        [ -n "$ip" ] || continue
        if docker inspect "$c" --format '{{range .NetworkSettings.Networks}}{{.IPAMConfig.IPv4Address}}{{end}}' 2>/dev/null | grep -q '[0-9]'; then
            printf '%-26s %-16s static\n' "$c" "$ip"
        else
            printf '%-26s %-16s dynamic\n' "$c" "$ip"
        fi
    done
}

# A2: the published port does NOT exist by the time DOCKER-USER sees the packet.
# Docker's DNAT has already rewritten the destination, so a rule naming the
# published port of a REMAPPED mapping can never match -- and ufw will list it
# as though it were doing something, which is precisely the failure this tool
# exists to stop.
#
# This detects the mistake rather than preventing it. Preventing it means
# matching the pre-DNAT port with `-m conntrack --ctorigdstport`, which in turn
# means generating DOCKER-USER from ufw's rule set and keeping the two in sync:
# a resident translator rather than a static stanza. The static stanza is what
# makes this tool auditable and survivable, so the trade is not obviously worth
# making. Tracked in FUTURE.md.
remap_rows() {   # name<TAB>published<TAB>container<TAB>proto, remapped only
    docker ps --format '{{.Names}}' 2>/dev/null | while read -r c; do
        [ -n "$c" ] || continue
        docker inspect "$c" --format \
            '{{range $p, $conf := .NetworkSettings.Ports}}{{if $conf}}{{(index $conf 0).HostPort}} {{$p}}
{{end}}{{end}}' 2>/dev/null \
        | while read -r hp cp; do
            [ -n "$hp" ] && [ -n "$cp" ] || continue
            local proto="${cp#*/}" port="${cp%%/*}"
            [ "$hp" = "$port" ] && continue          # 1:1, the rule works as written
            printf '%s\t%s\t%s\t%s\n' "$c" "$hp" "$port" "$proto"
        done
    done
}

check_remapped_rules() {
    local rules
    rules="$(iptables -S ufw-user-input 2>/dev/null; iptables -S ufw-user-forward 2>/dev/null)"
    [ -n "$rules" ] || return 0

    local name hp cp proto hit=0
    while IFS="$(printf '\t')" read -r name hp cp proto; do
        [ -n "$hp" ] || continue
        printf '%s' "$rules" | grep -qE -- "--dport $hp\\b" || continue
        # They may already have the right rule too, in which case say nothing.
        printf '%s' "$rules" | grep -qE -- "--dport $cp\\b" && continue
        [ "$hit" -eq 0 ] && bad "ufw rules that CANNOT match a container, because the port is remapped:"
        hit=1
        say  "    $name publishes $hp -> $cp/$proto, and you have a rule for $hp."
        say  "      after DNAT the rule must name the CONTAINER port:"
        say  "        ufw allow $cp/$proto        # not $hp"
        say  "      (if that rule is for a HOST service on $hp, it is correct as it is)"
    done <<EOF
$(remap_rows)
EOF
    [ "$hit" -eq 1 ] && return 1
    return 0
}

# A7. Containers on the host network have NO address of their own, so
# container_rows drops them -- and the operator cannot see the thing they
# cannot target. They are listed separately, with deliberately different
# words from the preflight's.
#
# "Not governed by ufw-docker" is the accurate phrase, and it is NOT
# "unsupported". Host-network containers traverse INPUT like any host service,
# so ordinary ufw rules already govern them correctly. Spending the word
# "unsupported" on something that works fine is how it stops being read in the
# cases where it means real danger -- Swarm, rootless, a mixed backend.
host_net_containers() {
    local c
    docker ps --format '{{.Names}}' 2>/dev/null | while read -r c; do
        [ -n "$c" ] || continue
        [ "$(docker inspect "$c" --format '{{.HostConfig.NetworkMode}}' 2>/dev/null)" = host ] \
            && printf '%s\n' "$c"
    done
}

cmd_containers() {
    require_docker containers
    head_ "containers"
    say "target one with:  ufw allow to <ip> port <CONTAINER port>"
    say "note the CONTAINER port, not the published one — see docs/per-container.md"
    say ""
    printf '  %-26s %-16s %s\n' NAME ADDRESS KIND
    container_rows | sed 's/^/  /'
    say ""
    say "'dynamic' addresses change when the container is recreated, and a rule"
    say "written against one will then match nothing. Pin with Docker IPAM."

    local rootless; rootless="$(rootless_daemons)"
    if [ -n "$rootless" ]; then
        head_ "rootless Docker daemon(s) — their containers are NOT listed above"
        printf '%s' "$rootless" | awk -F'|' '{printf "    %s  %s\n", $1, $2}'
        say ""
        say "This tool talks to the rootful daemon only, so nothing a rootless"
        say "daemon runs appears in the table above — however many ports it"
        say "publishes. Ask that daemon directly:"
        say "    sudo -u <user> XDG_RUNTIME_DIR=/run/user/<uid> docker ps"
        say ""
        say "Their published ports are userspace listeners on the host, so they"
        say "arrive on INPUT and your ORDINARY ufw rules govern them — by the"
        say "PUBLISHED port, and under ufw's default policy."
    fi

    local hostnet; hostnet="$(host_net_containers)"
    if [ -n "$hostnet" ]; then
        head_ "on the HOST network — not governed by ufw-docker"
        printf '%s\n' "$hostnet" | sed 's/^/    /'
        say ""
        say "These share the host's network namespace, so they have no address of"
        say "their own and 'ufw allow to <ip>' can never target them."
        say ""
        say "That is not a gap: their traffic arrives on INPUT like any host"
        say "service, so your ORDINARY ufw rules already govern them —"
        say "'ufw allow 8080/tcp' works on these exactly as you would expect."
        say "It is the Docker-published ports that needed this tool, not these."
    fi
    return 0
}

# ── status: collect, then render ───────────────────────────────────────────
# `status` used to print as it checked. That made --json impossible without
# writing every check twice, and two copies of a check drift -- this file has
# already shipped three assertions that passed for the wrong reason. Checks now
# append to one array and the renderers read it, so text and JSON cannot
# disagree: one source of truth, two views.
#
# A useful side effect: messages carry no colour, because colour is applied at
# render time. That is what makes them safe to put in JSON.
ST_KEY=(); ST_LEVEL=(); ST_MSG=(); ST_EXTRA=()

st() {   # $1=key  $2=ok|warn|bad|info|head  $3=message  [$4=indented detail]
    ST_KEY+=("$1"); ST_LEVEL+=("$2"); ST_MSG+=("$3"); ST_EXTRA+=("${4:-}")
}

strip_ansi() { sed 's/\x1b\[[0-9;]*m//g'; }

json_str() {   # one JSON string literal, correctly escaped
    local v="$1"
    v="${v//\\/\\\\}"; v="${v//\"/\\\"}"
    v="${v//$'\n'/\\n}"; v="${v//$'\t'/\\t}"; v="${v//$'\r'/\\r}"
    printf '"%s"' "$v"
}

render_text() {
    local i n="${#ST_KEY[@]}"
    for (( i=0; i<n; i++ )); do
        case "${ST_LEVEL[$i]}" in
            ok)   ok   "${ST_MSG[$i]}" ;;
            warn) warn "${ST_MSG[$i]}" ;;
            bad)  bad  "${ST_MSG[$i]}" ;;
            head) head_ "${ST_MSG[$i]}" ;;
            *)    say  "${ST_MSG[$i]}" ;;
        esac
        [ -n "${ST_EXTRA[$i]}" ] && printf '%s\n' "${ST_EXTRA[$i]}" | sed 's/^/        /'
    done
    return 0
}

render_json() {   # $1 = overall rc
    local i n="${#ST_KEY[@]}" sep=""
    printf '{\n'
    printf '  "version": %s,\n'    "$(json_str "$VERSION")"
    printf '  "healthy": %s,\n'    "$([ "$1" -eq 0 ] && printf true || printf false)"
    printf '  "installed": %s,\n'  "$([ "$ST_INSTALLED" -eq 1 ] && printf true || printf false)"
    printf '  "supported": %s,\n'  "$([ -z "$PF_FAILED" ] && printf true || printf false)"
    printf '  "preflight_failed": ['
    for i in $PF_FAILED; do printf '%s%s' "$sep" "$(json_str "$i")"; sep=", "; done
    printf '],\n'
    printf '  "installed_unsupported": %s,\n' "$(json_str "$ST_UNSUP")"
    printf '  "ufw_dir": %s,\n'    "$(json_str "$UFW_DIR")"
    printf '  "ufw_paths_derived": %s,\n' "$([ "$UFW_PATHS_DERIVED" -eq 1 ] && printf true || printf false)"
    printf '  "checks": [\n'
    sep=""
    for (( i=0; i<n; i++ )); do
        [ "${ST_LEVEL[$i]}" = head ] && continue   # a text-layout device, not a finding
        printf '%s    {"key": %s, "level": %s, "message": %s' \
            "$sep" "$(json_str "${ST_KEY[$i]}")" "$(json_str "${ST_LEVEL[$i]}")" \
            "$(json_str "${ST_MSG[$i]}")"
        if [ -n "${ST_EXTRA[$i]}" ]; then
            printf ', "detail": %s' "$(json_str "$(printf '%s' "${ST_EXTRA[$i]}" | strip_ansi)")"
        fi
        printf '}'
        # A REAL newline: printf '%s' does not interpret an escape in its
        # argument, so sep=",\n" emits a literal backslash-n and the document
        # stops being JSON.
        sep=$',\n'

    done
    printf '\n  ]\n}\n'
    return 0
}

ST_INSTALLED=0
ST_UNSUP=""

cmd_status() {
    require_docker status
    require_readable

    local show_rules=0 as_json=0 show_counters=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --rules) show_rules=1 ;;
            --json)  as_json=1 ;;
            --counters) show_counters=1 ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done

    ST_KEY=(); ST_LEVEL=(); ST_MSG=(); ST_EXTRA=()
    ST_INSTALLED=0; ST_UNSUP=""
    local rc=0

    # ── X1, on EVERY run, not only at install ──────────────────────────────
    # A host that is supported today can have its iptables backend switched
    # tomorrow, and nothing would otherwise say so. The stanza would still be
    # present and `status` would still report "wired".
    #
    # Whether that is a FAULT depends on whether anyone agreed to it:
    #
    #   accepted at install (--unsupported --force)  -> a known risk, warn
    #   NOT accepted                                 -> something changed
    #                                                   underneath us, rc=1
    #
    # Grading an accepted host red forever would make its exit code useless --
    # and an exit code that is always 1 is an exit code nobody reads, which
    # costs the ability to detect the real fault when it arrives.
    ST_UNSUP="$(installed_unsupported)"
    if preflight; then
        st supported ok "environment is a supported one"
    elif pf_all_accepted "$PF_FAILED" "$ST_UNSUP"; then
        st supported warn "UNSUPPORTED ENVIRONMENT ($PF_FAILED) — accepted at install time with --force:" \
            "$(printf '%s' "$PF_DETAIL" | awk -F'|' 'NF{printf "%s: %s\n  %s\n", $1, $2, $3}')"
    else
        st supported bad "UNSUPPORTED ENVIRONMENT — this tool is not proven here:" \
            "$(printf '%s' "$PF_DETAIL" | awk -F'|' 'NF{printf "%s: %s\n  %s\n", $1, $2, $3}')"
        rc=1
    fi

    local act; act=$(ufw status 2>/dev/null | grep -c 'Status: active') || true
    [ "${act:-0}" -eq 1 ] && st ufw-active ok "ufw active" \
        || { st ufw-active bad "ufw is NOT active"; rc=1; }

    local logc; logc=$(iptables -S 2>/dev/null | grep -cE '^-N ufw.*logging') || true
    [ "${logc:-0}" -ge 9 ] && st ufw-chains ok "ufw chains complete ($logc logging chains)" \
        || { st ufw-chains bad "ufw is half-built ($logc logging chains) — run ufw-docker rescue"; rc=1; }

    # B6: a blanket SSH accept an old `rescue` left in INPUT is a standing
    # exposure nobody chose, and nothing used to mention it.
    local stray; stray="$(stray_ssh_accept)"
    [ -n "$stray" ] && st stray-ssh-accept warn \
        "a blanket SSH ACCEPT sits directly in INPUT, outside ufw's chains:" \
        "$(printf '%s\n' "$stray"; printf 'an older ufw-docker rescue inserted this and left it.\nIf you did not intend SSH open to the world, remove it with:\n  iptables -D INPUT <the rule above, with -D in place of -A>\n')"

    local sshr; sshr=$(iptables -S ufw-user-input 2>/dev/null | grep -c 'dport 22') || true
    [ "${sshr:-0}" -gt 0 ] && st ssh-rule ok "SSH rule present" \
        || { st ssh-rule bad "NO SSH rule in ufw-user-input — run ufw-docker rescue NOW"; rc=1; }

    # "Not installed" is a perfectly valid state -- on a host that never ran
    # install, or straight after remove. Reporting the absent hook as a fault
    # there made `remove` exit non-zero, which is wrong and made the tool look
    # broken when it had just done exactly what was asked.
    grep -q "$MARK_BEGIN" "$AFTER4" 2>/dev/null && ST_INSTALLED=1

    if [ "$ST_INSTALLED" -eq 0 ]; then
        st installed info "ufw-docker: NOT installed (ufw rules do not affect Docker ports)"
        if [ "$as_json" -eq 1 ]; then render_json "$rc"; else head_ "ufw-docker status"; render_text; fi
        return $rc
    fi

    # Was this host wired while FAILING the preflight? Reported every run,
    # forever, because the person reading this is usually not the person who
    # typed --force.
    [ -n "$ST_UNSUP" ] && st installed-unsupported warn \
        "INSTALLED IN UNSUPPORTED MODE ($ST_UNSUP) — --force was used; filtering may silently not work"

    # Which version wired this host. The stanza carries it, so this answers the
    # question even when the binary has since been replaced -- which is the case
    # that matters, since a stanza written by an older version is exactly what a
    # confusing bug report looks like.
    local wired_v
    wired_v="$(grep -oE 'Managed by ufw-docker [0-9][^.]*\.[0-9]+\.[0-9]+' "$AFTER4" 2>/dev/null | awk '{print $4}' | head -1)"
    if [ -n "$wired_v" ] && [ "$wired_v" != "$VERSION" ]; then
        st version warn "wired by ufw-docker $wired_v, but this binary is $VERSION — re-run install"
    else
        st version info "version $VERSION${wired_v:+ (stanza matches)}"
    fi

    if [ -x "$BEFORE_INIT" ] && grep -q 'ufw-docker' "$BEFORE_INIT" 2>/dev/null; then
        st before-init ok "before.init hook installed"
    else
        st before-init bad "before.init hook MISSING — 'ufw reload' WILL break the firewall"; rc=1
    fi

    # Can the thing that repairs this host unattended actually run?
    #
    # `install` warns ONCE, at install time, when the binary is not at the path
    # the unit names -- and then nothing ever mentioned it again. A host in that
    # state printed every check green, including "DOCKER-USER is reached from
    # FORWARD", while the unit failed at every single boot.
    #
    # Verified by restarting a leg container's init with the binary absent from
    # /usr/local/sbin: unit `failed`, DOCKER-USER left at 0 jumps, status all
    # green. That is the same shape as the two false greens fixed before it --
    # a health report that is cheerful about a mechanism that cannot run.
    if [ -f "$SELFHEAL_UNIT" ]; then
        local sh_bin sh_en
        sh_bin="$(selfheal_execstart)"
        sh_en="$(systemctl is-enabled ufw-docker-selfheal.service 2>/dev/null || true)"
        if [ -n "$sh_bin" ] && [ ! -x "$sh_bin" ]; then
            st selfheal bad \
                "the self-heal unit calls $sh_bin, which is NOT executable — it fails at EVERY boot" \
                "Nothing repairs this host unattended. Put the tool where the unit expects it:
    sudo install -m 0755 $0 $sh_bin"
            rc=1
        elif [ "$sh_en" != enabled ]; then
            st selfheal bad \
                "the self-heal unit is installed but NOT enabled (${sh_en:-unknown}) — it will not run at boot" \
                "Enable it, or remove it with 'ufw-docker install --no-selfheal' so nothing
    implies a recovery that is not there:
    sudo systemctl enable ufw-docker-selfheal.service"
            rc=1
        elif systemctl is-failed --quiet ufw-docker-selfheal.service 2>/dev/null; then
            st selfheal warn \
                "the self-heal unit is in a FAILED state — its last run did not complete" \
                "journalctl -u ufw-docker-selfheal.service -b"
        else
            st selfheal ok "self-heal unit enabled, and $sh_bin is executable"
        fi
    else
        st selfheal info \
            "no self-heal unit — nothing repairs this host unattended (re-run install without --no-selfheal to add it)"
    fi

    # Does our logging agree with ufw's? The stanza bakes in whatever ufw's
    # setting was at install time, so the two drift the moment somebody runs
    # `ufw logging on|off` without re-running install. Silent drift in a logging
    # setting is how an audit trail quietly stops existing.
    local we_log=0
    grep -q -- '--log-prefix "\[UFW DOCKER BLOCK\] "' "$AFTER4" 2>/dev/null && we_log=1
    if ufw_logging_on; then
        [ "$we_log" -eq 1 ] \
            && st logging ok "blocked container traffic is logged ([UFW DOCKER BLOCK])" \
            || st logging warn "ufw logging is ON but ours is OFF — re-run install to match"
    else
        [ "$we_log" -eq 1 ] \
            && st logging warn "ufw logging is OFF but ours is still ON — re-run install to match" \
            || st logging info "logging off, matching ufw (blocked container traffic is silent)"
    fi

    local jf; jf=$(iptables -S DOCKER-USER 2>/dev/null | grep -c 'ufw-user-forward') || true
    [ "${jf:-0}" -gt 0 ] && st route-rules ok "\`ufw route\` rules are honoured ($jf jumps into ufw-user-forward)" \
        || st route-rules warn "\`ufw route\` rules are NOT honoured — re-run install"

    local j4; j4=$(iptables -S DOCKER-USER 2>/dev/null | grep -c 'ufw-user-input') || true
    [ "${j4:-0}" -gt 0 ] && st wired-v4 ok "IPv4 wired ($j4 jumps into ufw-user-input)" \
        || { st wired-v4 bad "stanza present but IPv4 NOT wired — run 'install' or 'ufw reload'"; rc=1; }

    # Counting jumps INSIDE the chain says nothing about whether the chain is
    # ever entered. Both must hold, and only one of them used to be checked.
    if forward_reaches_docker_user iptables; then
        st reachable-v4 ok "DOCKER-USER is reached from FORWARD"
    else
        st reachable-v4 bad \
            "DOCKER-USER is NOT reached from FORWARD — every rule above is in an orphaned chain and NOTHING is filtered" \
            "Docker adds that jump; check 'iptables -S FORWARD' and daemon.json's \"iptables\" setting"
        rc=1
    fi

    # Drift check. This is the failure nobody would otherwise see.
    local want have drift stale
    want="$(subnets 4 | sort -u)"
    have="$(stanza_subnets "$AFTER4")"
    drift="$(comm -23 <(printf '%s\n' "$want") <(printf '%s\n' "$have") 2>/dev/null)"
    if [ -n "$drift" ]; then
        st subnet-drift bad "SUBNET DRIFT — Docker networks not covered by the installed stanza:" \
            "$(printf '%s\n' "$drift"; printf 'traffic to these is filtered by nothing. Re-run: ufw-docker install\n')"
        rc=1
    else
        st subnet-drift ok "all Docker IPv4 subnets are covered"
    fi
    stale="$(comm -13 <(printf '%s\n' "$want") <(printf '%s\n' "$have") 2>/dev/null | grep -v ':' || true)"
    [ -n "$stale" ] && st subnet-stale warn \
        "stanza covers subnets Docker no longer has (harmless): $(echo "$stale" | tr '\n' ' ')"

    # A count only -- the full list floods `status` on a host with many
    # containers (15 on the development box). `ufw-docker containers` lists them.
    local ntot nstat
    ntot=$(docker ps -q 2>/dev/null | wc -l)
    nstat=$(container_rows | grep -c 'static') || true
    [ "${ntot:-0}" -gt 0 ] && st containers info \
        "containers: $ntot running, ${nstat:-0} with a static address  ('ufw-docker containers' to list)"

    if [ "$(ufw_default_incoming)" = allow ]; then
        st default-allow warn \
            "ufw's default incoming policy is ALLOW, but container traffic is default-DENY" \
            "    Our jump enters ufw-user-input directly, so the default policy -- which
    ufw keeps on the built-in chain -- is never consulted for containers.
    A published port with no explicit 'ufw allow' is dropped."
    fi

    local nbn; nbn="$(nonbridge_networks)"
    if [ -n "$nbn" ]; then
        st nonbridge-networks warn \
            "Docker network(s) this tool does NOT govern — their traffic never reaches DOCKER-USER:" \
            "$(printf '%s' "$nbn" | sed 's/|/  /g; s/^/    /')
    A macvlan or ipvlan container talks to the LAN directly, so NO rule on
    this host applies to it — not ufw's and not ours. Filter it upstream."
    fi


    # A9. Silence here is the whole problem: `containers` printed an EMPTY
    # table on a host with a rootless container publishing a port, and `status`
    # said nothing at all. The operator's reasonable reading of that is "this
    # box exposes nothing", which was false.
    local rl; rl="$(rootless_daemons)"
    if [ -n "$rl" ]; then
        st rootless warn \
            "rootless Docker daemon(s) here — this tool does NOT govern them:" \
            "$(printf '%s' "$rl" | awk -F'|' '{printf "    %s  %s\n", $1, $2}')
    A rootless published port is a userspace listener on the host, so its
    traffic arrives on INPUT and never reaches DOCKER-USER. Nothing in the
    stanza applies to it.

    That is not a hole -- plain 'ufw allow|deny <port>' DOES govern these.
    Two differences from the containers above, both easy to get wrong:
      - name the PUBLISHED port, not the container port
      - ufw's DEFAULT policy applies to them, so on a default-allow host
        they are OPEN while the bridge containers stay default-deny"
    fi

    local nhost; nhost="$(host_net_containers | grep -c . || true)"
    [ "${nhost:-0}" -gt 0 ] && st host-network info \
        "$nhost container(s) on the HOST network — not governed here; plain ufw INPUT rules apply to them"

    # Loud, not fatal: the rule may legitimately be for a host service on that
    # same port. Does not set rc -- a confusing rule is the operator's to judge.
    local remap; remap="$(check_remapped_rules 2>&1 | strip_ansi || true)"
    [ -n "$remap" ] && st remapped-rules warn \
        "ufw rules that CANNOT match a container, because the port is remapped:" \
        "$(printf '%s' "$remap" | sed -n '2,$p')"

    # C3: "are we wired?" is not the question an operator actually has. The
    # question is "which rules decide what reaches my containers?" -- and the
    # answer is these two chains, consulted in this order, for traffic whose
    # destination is a container address. Off by default because it is long.
    if [ "$show_rules" -eq 1 ]; then
        local fwd inp
        fwd="$(iptables -S ufw-user-forward 2>/dev/null | grep -v '^-N')"
        inp="$(iptables -S ufw-user-input 2>/dev/null | grep -v '^-N')"
        st _hdr head "rules containers are judged by, in order"
        st rules-forward info "ufw-user-forward  (\`ufw route ...\`, consulted FIRST):" "${fwd:-(none)}"
        st rules-input   info "ufw-user-input    (plain \`ufw allow|deny ...\`, consulted SECOND):" "${inp:-(none)}"
        st rules-note info "" \
"Reading these: a rule with NO destination governs the host AND every
container. A rule with -d <container ip> governs only that container.
Ports are CONTAINER ports, not published ones. See docs/scoping.md."
        st _hdr2 head "wiring"
    fi

    # C5. "Wired but filtering nothing" is the quietest failure in this whole
    # design, and a packet count is the cheapest visible signal of it.
    #
    # Deliberately NOT a warning when the counters are flat. A quiet host is a
    # perfectly normal host -- a box nobody is attacking and whose containers
    # nothing reaches legitimately will sit at zero for weeks. Warning on that
    # trains people to ignore the output. Show the number; the operator knows
    # whether their host should be seeing traffic.
    if [ "$show_counters" -eq 1 ]; then
        st _hdrc head "DOCKER-USER counters (packets / bytes, since the chain was last built)"
        local ctr
        ctr="$(iptables -L DOCKER-USER -n -v 2>/dev/null | sed -n '3,$p' | grep -v '^$')"
        st counters info "" "${ctr:-(chain is empty or unreadable)}"
        st counters-note info "" \
"A rule at 0 is not evidence of a problem. These reset on every rebuild --
install, 'ufw reload' and the before.init hook all rebuild the chain --
so compare against how long ago the firewall was last applied, not
against uptime."
        st _hdrc2 head "wiring"
    fi

    local v6nets j6
    v6nets="$(subnets 6)"
    j6=$(ip6tables -S DOCKER-USER 2>/dev/null | grep -c 'ufw6-user-input') || true
    if [ -n "$v6nets" ]; then
        # Check ufw's own IPv6 switch FIRST. If it is off, "not wired" is the
        # symptom and this is the cause -- and no amount of re-running install
        # fixes it, because ufw will not read the file we write.
        if ! ufw_ipv6_enabled; then
            st wired-v6 bad \
                "Docker has IPv6 networks but ufw has IPV6=no in $UFW_DEFAULTS — ufw never loads
    after6.rules, so our IPv6 stanza is dead text and v6 INTO CONTAINERS IS UNFILTERED" \
                "Re-running install will not fix this; ufw has to be doing v6 first:
    sudo sed -i 's/^IPV6=.*/IPV6=yes/' $UFW_DEFAULTS
    sudo ufw reload && sudo ufw-docker install"
            rc=1
        elif [ "${j6:-0}" -gt 0 ]; then
            st wired-v6 ok "IPv6 wired ($j6 jumps into ufw6-user-input)"
        else
            st wired-v6 bad "Docker has IPv6 networks but IPv6 is NOT wired — v6 is unfiltered"
            rc=1
        fi
        # Only meaningful where we actually write a v6 stanza; with Docker v6
        # off there is no v6 FORWARD jump and that is correct, not a fault.
        forward_reaches_docker_user ip6tables \
            || { st reachable-v6 bad "DOCKER-USER is NOT reached from the IPv6 FORWARD chain — v6 rules are in an orphaned chain"; rc=1; }
    else
        st wired-v6 info "IPv6: Docker has no v6 networks; nothing to wire"
    fi

    if [ "$as_json" -eq 1 ]; then
        render_json "$rc"
    else
        head_ "ufw-docker status"
        render_text
    fi
    return $rc
}

# ── rescue ─────────────────────────────────────────────────────────────────
# Deliberately different discipline from the rest of this file: NO `set -e`
# behaviour is relied on, every step is independent, and SSH is restored before
# any cleanup. A rescue path must push through failures, not abort on the first.
#
# Lives in the same file on purpose. Two files meant someone could install the
# tool and skip the rescue, which is the realistic failure -- more likely than a
# syntax error getting past `bash -n` and CI. One file cannot be half-installed.
cmd_rescue() {
    require_root rescue
    audit "RESCUE invoked ($*) — the firewall was in a state somebody had to recover from"
    local MODE="restore"
    [ "${1:-}" = "--open" ] && MODE="open"

    STAMP="$(date +%Y%m%d%H%M%S)"
    BACKUP="/var/backups/ufw-rescue-${STAMP}"
    mkdir -p "$BACKUP"

    head_ "ufw-docker rescue (${MODE})"
    say "forensic snapshot: $BACKUP"
    iptables-save  > "$BACKUP/iptables.v4"  2>/dev/null
    ip6tables-save > "$BACKUP/iptables.v6"  2>/dev/null
    cp -a $AFTER4  "$BACKUP/" 2>/dev/null
    cp -a $AFTER6 "$BACKUP/" 2>/dev/null
    cp -a $USER4   "$BACKUP/" 2>/dev/null

    # ── 1. SSH FIRST ───────────────────────────────────────────────────────────
    # Before touching anything else. A blanket accept at the top of INPUT works no
    # matter what state ufw's chains are in, and survives the cleanup below.
    head_ "1. restoring SSH"

    # ── WHY THIS IS NOT JUST `-A INPUT --dport 22 -j ACCEPT` ───────────────
    # The first version inserted a blanket ACCEPT on tcp/22 from anywhere. Two
    # problems, both serious once this runs unattended at boot:
    #
    #   * On a host deliberately locked to one source (a VPN endpoint, say), it
    #     silently opened SSH to the internet -- and if ufw then came back
    #     WITHOUT its own SSH rule, the blanket was left in place permanently.
    #   * It hardcoded port 22, so a host running sshd on 2222 got no
    #     protection from this step at all.
    #
    # So: find the real SSH port(s), and replay the operator's OWN rules from
    # user.rules, which is untouched by anything here. A blanket is the last
    # resort, and it says so loudly.
    SSH_PORTS="$(detect_ssh_ports)"
    if [ "$SSH_SRC" = GUESS ]; then
        warn "could not determine the SSH port from systemd, sshd -T or the"
        warn "listening sockets. ASSUMING 22 — if sshd is on another port,"
        warn "this rescue will not restore access to it. Check before relying"
        warn "on this, and use 'ufw-docker rescue --open' if you are locked out."
    fi
    say "sshd port(s): $(echo "$SSH_PORTS" | tr '\n' ' ') (from: $SSH_SRC)"

    INSERTED="" ; NOSSH=""
    for port in $SSH_PORTS; do
        rules="$(ssh_rules_in "$USER4" "$port")"
        src="your user.rules"

        # Fall back to the newest forensic snapshot. Every previous rescue
        # copied user.rules into one, so if ufw's file has since been reset or
        # truncated, the operator's real rules are still recoverable from
        # there -- and recovering them beats inventing something.
        if [ -z "$rules" ]; then
            snap="$(ls -1dt /var/backups/ufw-rescue-*/user.rules 2>/dev/null | head -1)"
            if [ -n "$snap" ]; then
                rules="$(ssh_rules_in "$snap" "$port")"
                [ -n "$rules" ] && src="$snap"
            fi
        fi

        if [ -n "$rules" ]; then
            echo "$rules" | while IFS= read -r r; do
                # shellcheck disable=SC2086
                iptables -I INPUT 1 ${r#-A ufw-user-input } 2>/dev/null
            done
            INSERTED="${INSERTED}${rules}
"
            ok "replayed your own rule(s) for port $port (from $src):"
            echo "$rules" | sed 's/^/      /'
        else
            # ── B6: INVENT NOTHING ────────────────────────────────────────
            # This used to insert a blanket ACCEPT. On a host whose SSH is
            # deliberately restricted -- to a VPN source, or to an interface --
            # that does not RESTORE access, it GRANTS access that never
            # existed, and silently widens the host's exposure at the exact
            # moment nobody is watching, because this also runs unattended
            # from the self-heal unit at boot.
            #
            # If ufw has no rule permitting SSH, the honest reading is that ufw
            # was never permitting SSH. `rescue --open` already exists for the
            # deliberate "get me in regardless" case, and it is explicit about
            # what it costs.
            NOSSH="${NOSSH}${port} "
            warn "no rule permitting port $port found in user.rules or any snapshot"
            warn "  NOT inventing one. If ufw never allowed $port, opening it now"
            warn "  would grant access that never existed rather than restore it."
            warn "  If you are locked out and want the firewall down:"
            warn "      ufw-docker rescue --open"
        fi
    done

    if [ "$MODE" = "open" ]; then
        head_ "2. emergency: taking the firewall down"
        ufw --force disable >/dev/null 2>&1
        for t in INPUT FORWARD OUTPUT; do iptables -P "$t" ACCEPT 2>/dev/null; done
        ok "ufw disabled; INPUT/FORWARD/OUTPUT policies set to ACCEPT"
        warn "THIS HOST IS NOW UNFILTERED. Re-run 'ufw-docker rescue' without --open"
        warn "once you have access, to rebuild a working firewall."
        return 0
    fi

    # ── 2. remove our Docker stanza ────────────────────────────────────────────
    head_ "2. removing the DOCKER-UFW stanza"
    for f in $AFTER4 $AFTER6; do
        [ -f "$f" ] || continue
        if grep -qF 'BEGIN DOCKER-UFW' "$f" 2>/dev/null; then
            sed -i '/# BEGIN DOCKER-UFW/,/# END DOCKER-UFW/d' "$f"
            ok "stripped from $f"
        else
            say "not present in $f"
        fi
    done

    # ── 3. release references to ufw's chains ──────────────────────────────────
    # This is the step that actually unblocks ufw. While DOCKER-USER still jumps to
    # ufw-user-input, iptables refuses to delete that chain, ufw's rebuild fails
    # part-way, and the firewall is left inconsistent.
    head_ "3. returning DOCKER-USER to stock"
    for ipt in iptables ip6tables; do
        command -v "$ipt" >/dev/null || continue
        if "$ipt" -S DOCKER-USER >/dev/null 2>&1; then
            "$ipt" -F DOCKER-USER 2>/dev/null
            "$ipt" -A DOCKER-USER -j RETURN 2>/dev/null
            ok "$ipt: DOCKER-USER reset to a single RETURN"
        fi
    done

    # ── 3b. nft fallback ───────────────────────────────────────────────────────
    # Observed for real after a test run: ufw-user-input ended up expressed in
    # NATIVE nft syntax (`tcp dport 22 accept`, without the `meta l4proto tcp`
    # prefix iptables-nft emits). The compat layer then refuses to touch it --
    #   iptables: chain `ufw-user-input' in table `filter' is incompatible, use 'nft'
    # -- so every iptables -F/-X above silently does nothing, ufw cannot rebuild,
    # and the firewall stays broken. The only way out is to clear the chains at the
    # nft level, which also means removing the base-chain jumps that reference them.
    head_ "3b. checking for nft-incompatible chains"
    if command -v nft >/dev/null 2>&1; then
        # The test must be "exists in nft AND iptables cannot read it".
        #
        # Matching the error string is NOT sufficient, which took a round trip to
        # learn: iptables-nft prints the identical message for a chain that does
        # not exist at all --
        #     $ iptables -S definitely-not-a-chain
        #     chain `definitely-not-a-chain' ... is incompatible, use 'nft' tool.
        # -- and an absent ufw-user-input is a perfectly ordinary state (ufw
        # disabled, chains already torn down). Keying on the string alone sent a
        # healthy host down this destructive path.
        if nft list chain ip filter ufw-user-input >/dev/null 2>&1 \
           && ! iptables -S ufw-user-input >/dev/null 2>&1; then
            # H1. This condition has been seen exactly ONCE, and never since:
            # zero occurrences across four full local suite runs and both CI
            # backends under the corrected detection above. The earlier belief
            # that it "fires reliably" was the STRING-MATCHING bug -- an absent
            # chain prints the same message, and an absent chain at the end of
            # a run is perfectly ordinary.
            #
            # So we cannot reproduce it, and a guard we cannot exercise is a
            # guard we cannot trust. The next best thing to a reproducer is to
            # make the next real occurrence self-reporting: record it in syslog
            # and keep the chain as nft renders it, so whoever sees this has
            # the evidence we currently lack rather than just a repaired host.
            audit "STEP 3B FIRED — ufw chains unreadable by iptables (nft-native syntax). Please report: $BACKUP/nft-incompatible.txt"
            nft list table ip filter > "$BACKUP/nft-incompatible.txt" 2>&1 || true
            warn "ufw chains are not readable by iptables; clearing them with nft"
            warn "  THIS IS RARE AND WE WANT TO KNOW ABOUT IT."
            warn "  Evidence saved: $BACKUP/nft-incompatible.txt"
            for base in INPUT FORWARD OUTPUT; do
                while :; do
                    h=$(nft -a list chain ip filter "$base" 2>/dev/null \
                        | grep -E 'jump ufw' | grep -oE 'handle [0-9]+' | head -1 | awk '{print $2}')
                    [ -n "$h" ] || break
                    nft delete rule ip filter "$base" handle "$h" 2>/dev/null || break
                done
            done
            for c in $(nft list table ip filter 2>/dev/null | grep -oE 'chain ufw[A-Za-z0-9_-]*' | awk '{print $2}'); do
                nft flush chain ip filter "$c" 2>/dev/null
            done
            for c in $(nft list table ip filter 2>/dev/null | grep -oE 'chain ufw[A-Za-z0-9_-]*' | awk '{print $2}'); do
                nft delete chain ip filter "$c" 2>/dev/null
            done
            LEFT=$(nft list table ip filter 2>/dev/null | grep -c 'chain ufw')
            [ "$LEFT" -eq 0 ] && ok "nft: ufw chains cleared" \
                              || warn "nft: $LEFT ufw chain(s) remain"
        else
            say "iptables can read ufw's chains — no nft cleanup needed"
        fi
    else
        say "nft not available — skipping"
    fi

    # ── 4. tear ufw down to nothing ────────────────────────────────────────────
    head_ "4. tearing ufw down"
    ufw --force disable >/dev/null 2>&1
    for ipt in iptables ip6tables; do
        command -v "$ipt" >/dev/null || continue
        CHAINS=$("$ipt" -S 2>/dev/null | grep -oE '^-N ufw[A-Za-z0-9_-]*' | awk '{print $2}')
        for c in $CHAINS; do "$ipt" -F "$c" 2>/dev/null; done
        for c in $CHAINS; do "$ipt" -X "$c" 2>/dev/null; done
        # Chains still referenced by the builtin INPUT/FORWARD/OUTPUT jumps cannot
        # be deleted ("CHAIN_DEL failed (Device or resource busy)"), and ufw does
        # not remove those jumps on disable. That is FINE -- `ufw enable` flushes
        # and reuses them. What actually matters is that they are EMPTY, so no stale
        # rule survives the rebuild. Reporting the leftover count as a problem was a
        # false alarm, which is the last thing a rescue script should produce.
        LEFT=$("$ipt" -S 2>/dev/null | grep -cE '^-N ufw')
        STALE=$("$ipt" -S 2>/dev/null | grep -cE '^-A ufw')
        if [ "$STALE" -eq 0 ]; then
            ok "$ipt: ufw chains emptied ($LEFT skeleton chain(s) kept, reused on rebuild)"
        else
            warn "$ipt: $STALE rule(s) still in ufw chains after flush"
        fi
    done

    # ── 5. rebuild from ufw's own config ───────────────────────────────────────
    # user.rules is untouched by any of the above, so the operator's real rules --
    # including their SSH allow -- come back exactly as they were.
    head_ "5. rebuilding ufw"
    if ufw --force enable 2>&1 | sed 's/^/  /'; then :; fi

    # ── 6. verify ──────────────────────────────────────────────────────────────
    head_ "6. verification"
    RC=0
    ufw status >/dev/null 2>&1 && ufw status | grep -q 'Status: active' \
      && ok "ufw is active" || { bad "ufw is NOT active"; RC=1; }

    LOGCHAINS=$(iptables -S 2>/dev/null | grep -cE '^-N ufw.*logging')
    [ "$LOGCHAINS" -ge 9 ] && ok "logging chains complete ($LOGCHAINS)" \
      || { bad "only $LOGCHAINS logging chains — ufw is still half-built"; RC=1; }

    # The live chain is written in exactly the syntax user.rules uses, so the
    # SAME matcher decides here. It used to count `--dport $port` only -- the
    # identical blind spot step 1 had, which meant a host whose SSH is allowed
    # by interface was told "ufw has NO SSH rule" and had the temporary rules
    # left in place permanently.
    LIVE="$BACKUP/live-ufw-user-input"
    iptables -S ufw-user-input > "$LIVE" 2>/dev/null
    SSHRULES=0
    for port in $SSH_PORTS; do
        n=$(ssh_rules_in "$LIVE" "$port" | grep -c . || true)
        SSHRULES=$((SSHRULES + n))
    done

    if [ "$SSHRULES" -gt 0 ]; then
        ok "ufw has its own SSH rule(s) back:"
        for port in $SSH_PORTS; do
            ssh_rules_in "$LIVE" "$port" | sed 's/^/      /'
        done
        # Remove exactly what step 1 added -- no more, no less.
        printf '%s' "$INSERTED" | while IFS= read -r r; do
            [ -n "$r" ] || continue
            # shellcheck disable=SC2086
            iptables -D INPUT ${r#-A ufw-user-input } 2>/dev/null
        done
        say "removed the temporary rule(s) added at step 1"
    else
        bad "ufw has NO rule permitting SSH after the rebuild"
        printf '%s' "$INSERTED" | grep -q . && {
            bad "  the step 1 rule(s) are being LEFT IN PLACE so you keep access"
            bad "  they are YOUR OWN rules replayed, not a widening of exposure"
        }
        for port in $NOSSH; do
            say  "  nothing permits port $port, and rescue did not invent anything."
            say  "  If you expect ufw to allow it, add the rule you meant:"
            say  "      ufw allow from <your-ip> to any port $port proto tcp"
            say  "  If you are locked out right now:  ufw-docker rescue --open"
        done
        RC=1
    fi

    head_ "result"
    if [ "$RC" -eq 0 ]; then
        ok "firewall restored and verified"
    else
        bad "restore incomplete — SSH should still work, but check the above"
        say "if you are still locked out, run: ufw-docker rescue --open"
    fi
    say "snapshot of the broken state kept at: $BACKUP"
    audit "rescue finished rc=$RC (snapshot $BACKUP)"
    prune_backups /var/backups/ufw-rescue-
    return $RC

}

# Before anything reads or writes one of ufw's files.
derive_ufw_paths

# ── per-subcommand help ────────────────────────────────────────────────────
# D3. `remove --help` used to print the global block, which lists every
# subcommand and explains none of their flags -- so the single question it
# was asked ("what does --include-backups actually do?") was the one it would
# not answer.
#
# Sequenced last on purpose: --dry-run, --rules, --json, --counters,
# --unsupported, --force and --purge all arrived after this was triaged, and
# writing it first would have meant writing it twice.
#
# Routed from the DISPATCHER rather than from inside each cmd_*, so that
# `ufw-docker remove --help` works without sudo. Those functions call
# require_root before they parse anything, and refusing to explain a flag
# until you are root is a small, daily, pointless obstruction.
#
# No man page: it would duplicate this, need separate installation, and fight
# the single-file property that makes this tool one curl.
wants_help() {
    local a
    for a in "$@"; do case "$a" in --help|-h) return 0 ;; esac; done
    return 1
}

subcmd_help() {
    case "$1" in
    install) cat <<'H'
ufw-docker install [--dry-run] [--no-selfheal] [--unsupported --force]

  Wire ufw into Docker's DOCKER-USER chain so plain `ufw allow` and `ufw deny`
  govern Docker-published ports. Idempotent: re-running strips our own stanza
  and rewrites it, which is how you pick up new Docker subnets or a new
  version of this tool.

  --dry-run, -n   Print the exact stanza that would be written, the hook and
                  self-heal intentions, and the preflight verdict. Changes
                  nothing at all.

  --no-selfheal   Skip the boot-time repair unit. That unit re-wires
                  DOCKER-USER if it is found empty at boot, which is the
                  failure with no other symptom -- so skipping it is a real
                  choice, not a tidiness option.

  --unsupported   Acknowledge that this host fails the supported-environment
                  preflight. ON ITS OWN THIS STILL REFUSES; it has to be given
                  together with --force.

  --force         Required alongside --unsupported. Two flags, because one
                  flag is something you can paste from a forum post without
                  reading it. Installing this way is recorded in the stanza
                  and reported by every `status` run from then on.

  Re-run install after: creating or removing a Docker network, running
  `ufw logging on|off`, or upgrading this tool. `status` reports all three.
H
    ;;
    remove) cat <<'H'
ufw-docker remove [--force] [--include-backups] [--purge]

  Undo the install. WITHOUT --force this only PREVIEWS -- it prints what would
  be removed and what would be left, and changes nothing.

  --force, -f         Actually do it.

  --include-backups   Also delete the after.rules backups and the
                      /var/backups/ufw-rescue-* snapshots. Requires --force.
                      The backup taken by THIS run is kept: it is the way back
                      if the removal itself goes wrong.

  --purge             Also delete this binary. Requires --force. Without it
                      the binary is deliberately left behind -- reinstalling is
                      the likely next step, and `rescue` has to stay reachable
                      exactly when you have just unwound the firewall.

  What remove does NOT touch: any of your ufw rules. They all survive and keep
  governing services on the HOST. They simply stop affecting Docker-published
  ports again, which is the state you were in before installing.
H
    ;;
    status) cat <<'H'
ufw-docker status [--rules] [--counters] [--json]

  Report what is wired and whether it is healthy. EXIT 1 MEANS NEEDS
  ATTENTION, so this is usable straight from cron or a monitoring check.

  --rules      Also list the two chains that decide what reaches containers,
               in the order they are consulted: ufw-user-forward (written by
               `ufw route ...`) first, then ufw-user-input.

  --counters   Also show DOCKER-USER packet and byte counts. "Wired but
               filtering nothing" is the quietest failure in this design and a
               packet count is the cheapest signal of it. A zero is NOT
               reported as a fault: a quiet host is a normal host.

  --json       The same report, machine-readable. Every check carries a stable
               `key`, so an alert can name a condition instead of matching a
               sentence. Top level: healthy, installed, supported,
               preflight_failed, installed_unsupported.

  Checked on EVERY run, not only at install: whether this host is still a
  platform the tool has been proven on. A host can stop being one without
  anybody touching this tool, by switching the iptables backend.
H
    ;;
    rescue) cat <<'H'
ufw-docker rescue [--open]

  Recover a firewall that is in a bad state. Restores SSH FIRST, before
  touching anything else, then unwinds our stanza, returns DOCKER-USER to
  stock, rebuilds ufw and verifies the result. A forensic snapshot of the
  broken state is kept under /var/backups/ufw-rescue-<timestamp>.

  It NEVER opens a port you had not already opened. It replays YOUR OWN rules
  from user.rules -- including interface- and source-scoped ones that name no
  port at all -- falling back to the newest snapshot; and if nothing permits
  SSH it invents nothing and tells you so.

  --open   EMERGENCY. Disables ufw entirely and sets INPUT, FORWARD and OUTPUT
           to ACCEPT. THE HOST IS THEN UNFILTERED. This is the deliberate "get
           me in regardless" case; run `rescue` without it once you are back.
H
    ;;
    containers) cat <<'H'
ufw-docker containers

  List running containers with the address and kind you need in order to write
  a per-container rule:

      ufw allow to <ip> port <CONTAINER port> proto tcp

  Note CONTAINER port, not published port. Docker DNATs before this tool ever
  sees the packet, so a rule naming the published port can never match.

  'dynamic' addresses change when a container is recreated, and a rule written
  against one then matches nothing. Pin the address with Docker IPAM.

  Containers on the HOST network are listed separately. They have no address
  of their own and cannot be targeted this way -- but they need nothing from
  this tool, because their traffic traverses INPUT and ordinary ufw rules
  already govern them correctly.
H
    ;;
    platforms) cat <<'H'
ufw-docker platforms

  Print the supported-platform matrix, and say where this host sits in it.

  Matching is on distro + major version + iptables backend. ufw and Docker
  versions are recorded but deliberately NOT matched on: they move constantly,
  and gating on them would turn every routine upgrade into a refusal.

  A row may say `supported` only where its verified-by column names real
  evidence -- a green CI leg, or a full suite run on a host of that class. A
  host matching no supported row is refused by `install`, which can be
  overridden with `install --unsupported --force`.
H
    ;;
    selfheal) cat <<'H'
ufw-docker selfheal

  Check the wiring and repair it if it is broken. This is what the boot-time
  systemd unit runs. Running it by hand is safe, and does nothing at all on a
  healthy host.

  It exists for the failure with no other symptom: DOCKER-USER found empty
  after a boot, where `ufw status` looks entirely normal while nothing is
  actually filtering container traffic.
H
    ;;
    *) return 1 ;;
    esac
    return 0
}

case "${1:-}" in
    install) shift; wants_help "$@" && { subcmd_help install; exit 0; }; cmd_install "$@" ;;
    rescue) shift; wants_help "$@" && { subcmd_help rescue; exit 0; }; cmd_rescue "$@" ;;
    remove|uninstall) shift; wants_help "$@" && { subcmd_help remove; exit 0; }; cmd_remove "$@" ;;
    status) shift; wants_help "$@" && { subcmd_help status; exit 0; }; cmd_status "$@" ;;
    selfheal) shift; wants_help "$@" && { subcmd_help selfheal; exit 0; }; cmd_selfheal "$@" ;;
    containers) shift; wants_help "$@" && { subcmd_help containers; exit 0; }; cmd_containers "$@" ;;
    platforms) shift; wants_help "$@" && { subcmd_help platforms; exit 0; }; cmd_platforms "$@" ;;
    --version|-V|version) printf 'ufw-docker %s\n' "$VERSION" ;;
    # Usage is the header comment, printed up to the first blank line. Ranged by
    # marker rather than by line number: a hardcoded '2,14p' silently truncates
    # the moment a subcommand is added, which it did.
    --help|-h|help) sed -n '2,/^$/p' "$0" | sed 's/^#\{0,1\} \{0,1\}//' ;;
    *) sed -n '2,/^$/p' "$0" | sed 's/^#\{0,1\} \{0,1\}//'; exit 1 ;;
esac
